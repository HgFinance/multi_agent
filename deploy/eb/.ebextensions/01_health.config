# EB 헬스체크 경로. **`/health`(liveness)를 본다.**
#
# 담당: 도현
# 근거: 2026-08-10 블로커 4 수정 - `/health`는 저장소가 죽어도 200 degraded를 내고,
#       503은 `/health/ready`와 도메인 엔드포인트가 낸다.
#
# ▶ 여기에 `/health/ready`를 넣으면 안 된다. Supabase 순단 몇 초에 EB가 인스턴스를
#   교체하기 시작하고, 그 사이 Outbox Relay와 Ledger Consumer까지 같이 죽는다.
#   프로세스가 살아서 주문을 올바르게 거절하는 상태를 "죽었다"로 판정하면 안 된다.
#   트래픽 차단이 필요하면 ALB Target Group 쪽에서 /health/ready를 보게 한다.
option_settings:
  aws:elasticbeanstalk:environment:process:default:
    HealthCheckPath: /health
    MatcherHTTPCode: "200"
    HealthCheckInterval: "30"
    HealthyThresholdCount: "3"
    UnhealthyThresholdCount: "5"

  # 배포 중 한 번에 다 내리지 않는다. Relay/Consumer가 동시에 사라지면 그 시간만큼
  # 체결이 원장에 안 들어간다(유실은 아니다 - outbox에 남아 있다가 따라잡는다).
  aws:elasticbeanstalk:command:
    DeploymentPolicy: Rolling
    BatchSizeType: Percentage
    BatchSize: "50"
