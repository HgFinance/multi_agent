# 공장 상주 프로세스 Image - 자동 조종 / 실험 워커 / 카드 감시자
#
# 담당: 재일 (리서치/퀀트)
# 근거: 재일님 결정 2026-08-12. 넷이 전부 호스트 셸 프로세스라, 세션이 끊기거나
#       Docker 를 재기동하면 **공장이 조용히 멈추고 아무도 안 알려줬다.**
#       실측: 새벽 3시대에 죽은 것을 다섯 시간 뒤에야 발견했다.
#
# ▶ 왜 컨테이너인가
#   `restart: unless-stopped` 가 죽은 프로세스를 살린다. 그리고 compose 한 줄로
#   AWS 에 그대로 간다 - 호스트 셸에 매인 상주는 옮길 수가 없다.
#
# ▶ 왜 docker CLI 가 들어가나
#   칸반 보드는 Windows 바인드 마운트 위의 SQLite 다. 호스트(또는 다른
#   컨테이너)가 그 파일을 직접 열면 `-shm` 매핑이 생겨 **부서 컨테이너의 모든
#   보드 쓰기가 죽는다**(실측). 그래서 보드 접근은 언제나
#   `docker exec <부서 컨테이너>` 로만 한다. 소켓은 compose 가 물려준다.
#
#   이 이미지에 docker 데몬이 있는 것이 아니라 **클라이언트만** 있다
#   (docker-outside-of-docker). 데몬은 호스트 것을 그대로 쓴다.
#
# ▶ 하나의 Image, 세 entrypoint
#   compose 가 command 로 고른다. 셋이 같은 저장소 코드를 보므로 이미지를
#   나누면 배포마다 버전이 어긋난다.

FROM python:3.12-slim

# docker CLI 만 설치한다(데몬 없음). apt 의 docker.io 는 데몬까지 끌고 오므로
# 공식 정적 바이너리를 쓴다 - 이미지가 작고 버전이 고정된다.
ARG DOCKER_CLI_VERSION=27.3.1
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends curl ca-certificates; \
    curl -fsSL "https://download.docker.com/linux/static/stable/x86_64/docker-${DOCKER_CLI_VERSION}.tgz" \
      -o /tmp/docker.tgz; \
    tar -xzf /tmp/docker.tgz -C /tmp; \
    mv /tmp/docker/docker /usr/local/bin/docker; \
    rm -rf /tmp/docker /tmp/docker.tgz; \
    apt-get purge -y curl; apt-get autoremove -y; rm -rf /var/lib/apt/lists/*; \
    docker --version

# fastapi/uvicorn/httpx 는 BFF(apps/api/main.py)용이다. 같은 이미지를 쓰는
# 이유는 BFF 도 칸반을 `docker exec` 로 만지기 때문이다 - 소켓과 코드가 이미
# 여기 있다.
RUN pip install --no-cache-dir \
      psycopg2-binary==2.9.10 pydantic==2.11.7 python-dotenv==1.1.1 \
      numpy==2.3.2 pandas==2.3.1 pyarrow==25.0.0 \
      fastapi==0.116.1 "uvicorn[standard]==0.35.0" httpx==0.28.1 \
      PyYAML==6.0.2

# langgraph: BFF 의 포트폴리오 추천 워크플로(orchestration/workflows)가 쓴다.
# 무거워서 레이어를 나눈다 - 공장 상주 셋은 이걸 안 쓰지만 같은 이미지다.
RUN pip install --no-cache-dir langgraph==0.6.7

# ▶ openai: 부서 Worker 가 로컬 Ollama 의 **OpenAI 호환 엔드포인트**를 부를 때 쓴다
#   (departments/employee_worker_runtime.py 의 default_worker_llm).
#   이게 없으면 PORTFOLIO_WORKER_RUNTIME=ollama 로 두어도 모든 Worker 가
#   `ModuleNotFoundError: No module named 'openai'` 로 **0.0초 만에** 실패하고,
#   부서는 DEGRADED, 파이프라인은 HOLD 로 떨어진다 - 2026-08-12 실측.
#   Ollama 를 안 쓰는 것처럼 보이는 게 아니라 "LLM 이 응답을 안 준다"로 보여
#   원인을 모델 쪽에서 찾게 된다. 버전은 risk/audit 이미지와 같은 핀을 쓴다.
RUN pip install --no-cache-dir openai==2.35.1

WORKDIR /app

# 저장소 경로 구조를 그대로 유지한다 - 모듈들이 Path(__file__) 상대로
# sys.path 를 넣는다(_ROOT = parents[1] 등). 평평하게 복사하면 임포트가 깨진다.
# Factory/quant modules only need the shared env loader.  Copying the entire
# collector directory would make retired or destructive entrypoints executable
# inside an always-on factory image.
COPY departments/01-research/collectors/source_registry.py ./departments/01-research/collectors/source_registry.py
COPY departments/01-research/contracts  ./departments/01-research/contracts
COPY departments/01-research/repository ./departments/01-research/repository
COPY departments/01-research/factory    ./departments/01-research/factory
# ▶ 이 한 줄이 없어서 **포트폴리오 파이프라인이 통째로 죽었다** (2026-08-12 실측).
#   orchestration/workflows/portfolio_recommendation.py 의 _MODULE_PATHS 가 부서
#   7개의 employee_workers 를 **파일 경로로** 로드하는데, 리서치 것만 이미지에
#   없어서 첫 단계(research_fanout)에서 FileNotFoundError 로 끝났다.
#   부서 폴더를 통째로 복사하지 않고 하위 디렉터리만 골라 담는 구조라 이렇게 빠진다.
#   이 파일이 필요로 하는 것은 departments/employee_worker_runtime.py 하나뿐이다
#   (아래에서 이미 복사한다) - agents/·evidence/ 는 안 딸려온다.
COPY departments/01-research/employee_workers.py ./departments/01-research/employee_workers.py
# 인사팀 워커(profile-architecture-worker). `orchestration/employee_dispatch.py` 의
# EMPLOYEE_MODULE_BY_DEPARTMENT 가 8개 부서를 전부 가리키는데 이것만 이미지에
# 없어서, hr 로 부르면 `employee_registry_file_missing:hr` 로 죽었다(2026-08-12).
# ⚠ 이 파일을 넣는다고 워커가 도는 것은 아니다 - 지금은 이 워커를 부르는 런타임
#   경로가 없다(workforce-api 는 run_employee_workers 를 부르지 않고, HR 프로필의
#   runtime_personalities 로 부서장이 소집하는 구조다. 부서 config.yaml 83행이
#   "실제 채용 사이클 종단 실행은 아직 검증 안 됨"으로 그 상태를 적어 두었다).
#   여기서 없애는 것은 "코드엔 있는데 배포엔 없다"는 **불일치**뿐이다.
COPY departments/07-agent-workforce/employee_workers.py ./departments/07-agent-workforce/employee_workers.py
COPY departments/04-quant-backtest      ./departments/04-quant-backtest
COPY apps/api                           ./apps/api
# orchestration/canonical_profiles.py 가 정본 부서 이름표다 - kanban_board 가
# "없는 본부에 배정된 카드"를 판정할 때 읽는다. 없으면 감시자가 뜨지 못한다.
COPY orchestration                      ./orchestration
# BFF 가 sys.path 에 직접 넣는 경로들(apps/api/main.py 55~59행). 회계 원장·
# 포트폴리오 모듈을 형제 모듈처럼 임포트하므로 구조를 그대로 둬야 한다.
COPY departments/05-accounting-portfolio ./departments/05-accounting-portfolio
COPY departments/02-trading             ./departments/02-trading
COPY departments/03-risk                ./departments/03-risk
COPY departments/06-ai-qa-audit         ./departments/06-ai-qa-audit
COPY departments/00-ceo-office          ./departments/00-ceo-office
COPY tests/e2e                          ./tests/e2e
# departments/ 바로 아래의 모듈들. employee_worker_runtime 은 포트폴리오
# 워크플로가 `departments.employee_worker_runtime` 로 임포트한다 - 부서 폴더만
# 복사하면 패키지는 생기는데 이 파일들이 없어 임포트가 죽는다.
COPY departments/employee_worker_runtime.py ./departments/employee_worker_runtime.py
COPY departments/worker_model_gateway.py    ./departments/worker_model_gateway.py
COPY departments/qwen_hybrid_runtime.py     ./departments/qwen_hybrid_runtime.py
COPY departments/01-research/config/worker_model_registry.json ./departments/01-research/config/worker_model_registry.json
COPY benchmarks/quantization/knowledge/bok800_2026/glossary_rag_v1.json ./benchmarks/quantization/knowledge/bok800_2026/glossary_rag_v1.json
COPY departments/notion_markdown.py         ./departments/notion_markdown.py
COPY departments/risk_qa_worker_profiles.py ./departments/risk_qa_worker_profiles.py

# Seal the proposal -> AST -> experiment execution surface into the image.
# A container-layer hotfix must become visible as unhealthy instead of letting
# the autopilot and worker silently execute different field registries.
COPY scripts/factory_runtime_contract.py ./scripts/factory_runtime_contract.py
COPY scripts/evolution_skills.py         ./scripts/evolution_skills.py
COPY skills/evolution-registry.json      ./skills/evolution-registry.json
RUN python scripts/factory_runtime_contract.py write

ENV PYTHONUNBUFFERED=1 PYTHONPATH=/app

HEALTHCHECK --interval=60s --timeout=10s --start-period=10s --retries=1 \
  CMD ["python", "scripts/factory_runtime_contract.py", "check"]

# 기본은 자동 조종. compose 가 워커·감시자를 각각 command 로 지정한다.
CMD ["python", "departments/01-research/factory/factory_autopilot.py", \
     "--loop", "--interval-min", "15"]
