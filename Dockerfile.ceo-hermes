ARG HERMES_BASE_IMAGE=nousresearch/hermes-agent:latest
FROM ${HERMES_BASE_IMAGE}

# CEO의 native kanban_create를 build-time에 HgFinance의 scoped primary
# idempotency 경계로 감싼다. runtime pip install이나 DB migration은 하지 않는다.
ENV PYTHONPATH="/opt/hgfinance:${PYTHONPATH}"

COPY --chmod=0644 orchestration/__init__.py /opt/hgfinance/orchestration/__init__.py
COPY --chmod=0644 orchestration/discord_idempotency.py /opt/hgfinance/orchestration/discord_idempotency.py
COPY --chmod=0644 orchestration/qa_discord_feedback.py /opt/hgfinance/orchestration/qa_discord_feedback.py
COPY --chmod=0644 orchestration/primary_task_idempotency.py /opt/hgfinance/orchestration/primary_task_idempotency.py
COPY --chmod=0644 deploy/hermes-discord/gateway_patch.py /opt/hgfinance/gateway_patch.py
COPY --chmod=0644 deploy/hermes-discord/install_patch.py /tmp/install_hermes_discord_patch.py
COPY --chmod=0644 deploy/ceo-kanban/install_primary_idempotency.py /tmp/install_primary_idempotency.py

RUN chmod -R a+rX /opt/hgfinance \
    && python3 /tmp/install_hermes_discord_patch.py \
    && python3 /tmp/install_primary_idempotency.py \
    && rm -f /tmp/install_hermes_discord_patch.py /tmp/install_primary_idempotency.py
