# 이 파일은 커밋된다. 실제 값은 절대 여기 넣지 않는다.
# 복사해서 쓴다:  cp .env.example .env
# 참고: docs/06-integrations/ls-openapi/README.md (origin/main 브랜치)

# --- LS증권 Open API: 앱키 -----------------------------------------------------
# 개발자센터에서 발급. 실전과 모의투자는 키가 별개다.
LS_APP_KEY=
LS_APP_SECRET=
LS_MOCK_APP_KEY=
LS_MOCK_APP_SECRET=

# --- LS증권 Open API: 계좌 -----------------------------------------------------
# 계좌번호는 보통 11자리, 비밀번호는 주문 TR(CSPAT00601) 요청 필드에 들어간다.
LS_ACCOUNT_NO=
LS_ACCOUNT_PASSWORD=
LS_MOCK_ACCOUNT_NO=
LS_MOCK_ACCOUNT_PASSWORD=

# --- LS증권 Open API: 엔드포인트 ------------------------------------------------
# MOCK | REAL. 실전 전환은 Production Launch Gate 통과 후에만 한다.
LS_ENV=MOCK

# 아래 두 값은 공식 문서에서 확인한 상수라 채워둔다. 비밀이 아니다.
#
# 주의: 모의투자 Domain은 WebSocket 실시간 시세에만 존재한다(:29443).
#       주문·계좌·OAuth를 포함한 REST 35개 API는 모의투자 Domain이 '-'이며
#       운영 Domain :8080 하나뿐이다. REST 모의주문 가능 여부는 미확인 상태다.
LS_REST_BASE_URL=https://openapi.ls-sec.co.kr:8080
LS_WS_URL=wss://openapi.ls-sec.co.kr:29443   # 모의투자. 운영은 :9443

# --- LLM / 외부 데이터 ----------------------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
TAVILY_API_KEY=

# --- DB -------------------------------------------------------------------------
# 팀원이 GitHub-Supabase 연동으로 관리한다. 로컬 검증용으로만 채운다.
DATABASE_URL=

# 트레이딩·회계는 TimescaleDB 자격증명을 갖지 않는다. 시계열은 market-api 경유.
# 참고: TECH_STACK_DECISIONS.md
