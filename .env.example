# ============================================================================
# HgFinance 저장소 Root 환경 변수 템플릿
#
# 사용법:
#   cp .env.example .env
#   $EDITOR .env
#   docker compose config --quiet
#
# 이 파일에는 변수명과 안전한 예시값만 둔다. 실제 Secret은 절대 커밋하지
# 않는다. `CHANGE_ME_*` 값은 서비스를 사용하기 전에 반드시 교체한다.
#
# 환경 구분:
#   local       개인 PC의 개발용 Compose
#   test        Fixture/Mock/Contract 검증용. 실제 Broker·운영 데이터 금지
#   production  AWS 운영 자문용. 실제 Broker 쓰기와 Live 승격은 별도 승인 필요
#
# 기본 원칙:
#   - Secret을 Log, Prompt, Frontend Bundle, Dataset에 넣지 않는다.
#   - Agent Container에는 Vendor API Key, 수집 DB Credential, Broker Credential을
#     넣지 않는다. Agent는 승인된 Domain API만 호출한다.
#   - local/test/production의 계정·Network·Secret·Data·Broker Credential을
#     분리한다. Replay 환경은 실제 Broker Credential을 가질 수 없다.
#   - AWS에서는 AWS Access Key 환경 변수보다 Instance Role/Workload Identity를
#     우선한다.
#
# 이 파일이 다루지 않는 영역:
#   1) Hermes Profile Runtime
#      ~/.hermes/profiles/<department>/.env 및 auth.json
#      저장소 Profile과 Runtime Profile의 동기화는
#      ./scripts/sync_hermes_profiles.sh 를 사용한다.
#   2) Frontend Cloudflare Worker
#      ai-office/.dev.vars.example을 사용하고, 배포 Secret은 wrangler secret으로
#      주입한다.
# ============================================================================


# ----------------------------------------------------------------------------
# 1. Compose 필수 Database 설정
# ----------------------------------------------------------------------------

# [local/test/production]
# Supabase 또는 해당 환경의 PostgreSQL DSN이다.
# Agent가 직접 사용하지 않고 Backend/Domain API가 사용한다.
DATABASE_URL=postgresql://DB_USER:CHANGE_ME_DB_PASSWORD@DB_HOST:5432/DB_NAME

# [local]
# 로컬 TimescaleDB 컨테이너의 관리자 비밀번호다.
# Compose가 컨테이너 내부 DSN을 자동으로 조합한다.
HEDGEFUND_TSDB_PASSWORD=CHANGE_ME_TSDB_PASSWORD

# [local/test/production]
# 뉴스 수집기와 배치 수집기에 필요한 Supabase 값이다.
SUPABASE_URL=https://CHANGE_ME_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=CHANGE_ME_SUPABASE_SERVICE_ROLE_KEY

# Compose 기본 기동의 뉴스 수집기에 필요한 NAVER API 값이다.
# 실제 키가 없는 환경은 news-watcher를 기동하기 전에 별도로 주입한다.
NAVER_CLIENT_ID=CHANGE_ME_NAVER_CLIENT_ID
NAVER_CLIENT_SECRET=CHANGE_ME_NAVER_CLIENT_SECRET

# [선택] Frontend/읽기 전용 클라이언트 값이다.
# SERVICE_ROLE_KEY나 DATABASE_URL을 대신하지 않는다.
SUPABASE_ANON_KEY=
SUPABASE_DATABASE_URL=
SUPABASE_PASSWORD=

# [host-only]
# 호스트에서 TimescaleDB를 직접 조회할 때만 사용한다.
# Compose 서비스 내부에서는 HEDGEFUND_TSDB_PASSWORD로 DSN을 만든다.
TIMESCALE_DATABASE_URL=postgresql://postgres:CHANGE_ME_TSDB_PASSWORD@127.0.0.1:5434/market


# ----------------------------------------------------------------------------
# 2. CEO / Kanban / Portfolio BFF
# ----------------------------------------------------------------------------

# [local/test/production]
# portfolio-bff에서 ceo-hermes API로 보내는 공유 인증값이다.
CEO_HERMES_API_KEY=CHANGE_ME_CEO_HERMES_API_KEY

# 허용값: true | false
# 대표 지시창 POST /ui/ceo/ask를 활성화한다.
ENABLE_AGENT_ASK=true

# 허용값: 1 | 0
# BFF가 공용 Hermes Kanban 보드에 사용자 질의를 기록할지 정한다.
ENABLE_KANBAN_TASK_TRACKING=1

# [컨테이너 내부 경로]
HERMES_BIN=/usr/local/bin/hermes
HERMES_HOME=/opt/hermes-cli
HERMES_KANBAN_HOME=/opt/kanban
HERMES_CEO_API_URL=http://ceo-hermes:8642/v1

# 허용값: deterministic | llm
# 기본값은 deterministic이다. LLM 기반 CEO Task Planner는 별도 검증 후 활성화한다.
PORTFOLIO_CEO_TASK_PLANNER_MODE=deterministic

# [선택] CEO Hermes API 요청에 기록할 모델 표시명이다.
HERMES_CEO_API_MODEL=hermes-agent

# [local/test/production]
# BFF를 호스트에 게시할 포트다.
PORTFOLIO_BFF_PORT=8001

# 허용값: true | false
# 거버넌스 Mandate와 Portfolio Runtime을 연결할지 정한다.
PORTFOLIO_GOVERNANCE_BINDING_ENABLED=false
GOVERNANCE_API_URL=
GOVERNANCE_API_AUTH_TOKEN=
GOVERNANCE_WORKFORCE_DATABASE_URL=
GOVERNANCE_EVENT_POLL_INTERVAL_SECONDS=1

# Portfolio Worker 설정
PORTFOLIO_WORKER_POLL_SECONDS=0.5
PORTFOLIO_WORKER_LEASE_SECONDS=60
PORTFOLIO_RUNTIME_STORE_PATH=/var/lib/portfolio/runtime.sqlite3

# 허용값: true | false
# 기본값은 false다. API와 Worker를 분리하고 Worker만 Queue를 claim한다.
PORTFOLIO_RUNTIME_EMBEDDED_WORKER=false
PORTFOLIO_RUNTIME_STORE_DIR=/tmp
PORTFOLIO_GOVERNANCE_BINDING_PATH=/governance/v1/mandates/{mandate_id}/current
PORTFOLIO_AUTH_REQUIRED=false
PORTFOLIO_REQUIRE_MANDATE_BINDING=false
UI_SNAPSHOT_CACHE_SECONDS=2


# ----------------------------------------------------------------------------
# 3. Redis / Event Worker
# ----------------------------------------------------------------------------

# [local]
# Compose 네트워크 안에서는 localhost가 아니라 서비스명 redis를 사용한다.
REDIS_URL=redis://redis:6379/0
RISK_QA_EVENT_REDIS_URL=redis://redis:6379/0

#------------------------------------------------------------------------------
# 5-1. Web/Discord CEO 미러링  [NOW]
#
# 기존 Compose Redis를 request/event dedup과 공용 CEO timeline 저장소로 사용한다.
# AWS 운영에서는 REDIS_URL 또는 UI_MIRROR_REDIS_URL 중 하나를 반드시 설정한다.
#
# 환경 선택:
#   local/test   Redis가 없으면 단위 테스트에서 InMemoryMirrorStore를 명시적으로 주입
#   production   AWS 기존 Redis URL 사용. dedup 저장소 장애 시 CEO 실행을 503으로 차단
#------------------------------------------------------------------------------
UI_MIRROR_REDIS_URL=
UI_MIRROR_STREAM=hf:ui-ceo-mirror:v1
UI_MIRROR_DEDUPE_TTL_SECONDS=604800
UI_MIRROR_DEDUPE_WAIT_SECONDS=3
UI_MIRROR_SSE_SECONDS=25
RISK_QA_EVENT_DEDUPE_TTL_SECONDS=604800
RISK_QA_EVENT_STREAM=risk-qa-events
QA_EVENT_GROUP=qa-workers
QA_EVENT_CONSUMER=qa-api
QA_EVENT_POLL_INTERVAL_SECONDS=1

WORKFORCE_EVENT_POLL_INTERVAL_SECONDS=1
WORKFORCE_EVENT_DEDUPE_TTL_SECONDS=604800
WORKFORCE_EVENT_STREAM=hf:workforce
WORKFORCE_EVENT_GROUP=workforce-api
WORKFORCE_EVENT_CONSUMER=workforce-api

RELAY_POLL_SECONDS=1.0
RELAY_MAX_ATTEMPTS=12
LEDGER_CONSUMER_POLL_SECONDS=1.0
ACCOUNTING_MARK_INTERVAL=

# [컨테이너 내부 URL]
MARKET_API_URL=http://market-api:8036
RESEARCH_API_URL=http://research-api:8035


# ----------------------------------------------------------------------------
# 4. Research 수집기 / 외부 Data Source
# ----------------------------------------------------------------------------

# 키가 없는 Source는 해당 수집기를 비활성화하거나 실패 처리한다.
TAVILY_API_KEY=
OPEN_DART_API_KEY=
KRX_API_KEY=
BIGKINDS_API_KEY=
ECOS_API_KEY=
KOSIS_API_KEY=
FRED_API_KEY=
UNPAYWALL_EMAIL=

# 뉴스 수집 범위와 주기
NEWS_WATCH_SYMBOLS=
NEWS_POLL_INTERVAL_SECONDS=1800
NEWS_WATCH_TOP=20
NEWS_WATCH_DISPLAY=20
NEWS_SINK_MAX_BATCH=20
NEWS_SINK_MAX_DELAY_SECONDS=5.0

# [local/test/production]
# Research MCP 호출 인증값이다. 공유 환경에서는 비워 두지 않는다.
MCP_RESEARCH_API_KEY=CHANGE_ME_MCP_RESEARCH_API_KEY
RESEARCH_MCP_PORT=8037

# 허용값: true | false
# false는 관측 모드, true는 Tool Gateway 허용목록 위반을 차단한다.
TOOL_GATEWAY_ENFORCE=false
TOOL_GATEWAY_ENFORCE_MARKET=false

# 선택적 Research/News Adapter
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_DATA_BASE_URL=
ALPACA_NEWS_WS_URL=
FOREIGN_NEWS_API_KEY=
SERPAPI_KEY=


# ----------------------------------------------------------------------------
# 5. LS증권 Open API
# ----------------------------------------------------------------------------

# 허용값: PAPER | LIVE
# 주문·계좌 실행 환경이다. 기본은 PAPER이며 LIVE는 Production Launch Gate
# 통과와 별도 승인 후에만 사용한다.
LS_ENV=PAPER

# 실전투자(LIVE) Credential / Endpoint
# LS_ENV=LIVE일 때만 사용한다.
LS_APP_KEY=
LS_APP_SECRET_KEY=
LS_REST_BASE_URL=https://openapi.ls-sec.co.kr:8080
LS_WS_BASE_URL=wss://openapi.ls-sec.co.kr:9443

# 모의투자(PAPER) Credential / Endpoint
# LS_ENV=PAPER일 때만 사용한다. Live 값과 절대 섞지 않는다.
LS_APP_KEY_PAPER=
LS_APP_SECRET_KEY_PAPER=
LS_REST_BASE_URL_PAPER=
LS_WS_BASE_URL_PAPER=wss://openapi.ls-sec.co.kr:29443

# Paper 계좌 Credential
LS_ACCOUNT_NO_PAPER=
LS_ACCOUNT_PWD_PAPER=

# Live 계좌 Credential은 기본적으로 비워 둔다.
LS_ACCOUNT_NO=
LS_MAC_ADDRESS=
LS_OAUTH_SCOPE=oob


# ----------------------------------------------------------------------------
# 6. Local Model / Worker Runtime
# ----------------------------------------------------------------------------

# [host process]
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# [Docker Linux/Windows 호환]
OLLAMA_DOCKER_BASE_URL=http://host.docker.internal:11434/v1

# [현재 Prototype]
# 허용값 예시: qwen3:1.7b
OLLAMA_CHAT_MODEL=qwen3:1.7b
OLLAMA_EMBEDDING_MODEL=
OLLAMA_TIMEOUT_SECONDS=8
OLLAMA_API_KEY=ollama
PORTFOLIO_WORKER_RUNTIME=ollama

# Risk/QA 직접 실행용 Provider Key
# Hermes Profile의 Provider Credential은 이 파일에 넣지 않는다.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=


# ----------------------------------------------------------------------------
# 7. Risk / QA / Accounting 환경 선택
# ----------------------------------------------------------------------------

# 허용값: test | production
# test는 Fixture/Mock 기반 검증, production은 외부 데이터와 실제 계약 검증이다.
# production 전환은 Preflight와 승인 절차를 통과해야 한다.
RISK_QA_RUNTIME=test

# 허용값: test | production
RISK_DATA_MODE=test

# 허용값: true | false
RISK_REQUIRE_P1_ANALYTICS=false
RISK_QA_PRODUCTION_ENABLED=false

# 허용값: request | database | artifact
RISK_CONTEXT_SOURCE=request

# 허용값 예시: paper | live | mock | 빈 값
RISK_BROKER_ADAPTER=
RISK_EXTERNAL_API_TIMEOUT_SECONDS=5
RISK_QA_DATABASE_URL=

# Risk/QA Domain API 서명 토큰
# [local/test/production] 환경별로 서로 다른 값을 사용한다.
RISK_SERVICE_AUTH_SECRET=CHANGE_ME_RISK_SERVICE_SECRET
RISK_SERVICE_AUTH_ISSUER=hgfinance-risk
RISK_SERVICE_AUTH_AUDIENCE=hgfinance-internal
QA_SERVICE_AUTH_SECRET=CHANGE_ME_QA_SERVICE_SECRET
QA_SERVICE_AUTH_ISSUER=hgfinance-qa
QA_SERVICE_AUTH_AUDIENCE=hgfinance-internal

# 허용값: test | production
# QA 문서/정책 Corpus 적재 모드다.
QA_INGEST_MODE=test
QA_POLICY_SOURCE_ID=
QA_CHECK_CONTRACT_APPROVED=false
QA_POLICY_CORPUS_DIR=
QA_EVIDENCE_CORPUS_DIR=

# 허용값: true | false
QA_TRACE_PERSIST=false

# 허용값: true | false
# true이면 Incident Timeline을 DATABASE_URL 또는 RISK_QA_DATABASE_URL에 영속화한다.
QA_INCIDENT_PERSIST=false

# Accounting 실행 모드
# 허용값: OFFLINE | PAPER_DB | DURABLE | PRODUCTION | LIVE_DB
ACCOUNTING_MODE=PAPER_DB

# 허용값: true | false
PAPER_DB=true
DISCORD_WEBHOOK_URL=
ACCOUNTING_DEFAULT_BOOK_ID=

# 내부 Domain API URL
RISK_API_URL=http://127.0.0.1:8041
RISK_API_AUTH_TOKEN=
RISK_API_TIMEOUT_SECONDS=8
QA_API_URL=http://127.0.0.1:8042
QA_API_AUTH_TOKEN=
QA_API_TIMEOUT_SECONDS=8


# ----------------------------------------------------------------------------
# 8. 법률 / Policy / Vector RAG
# ----------------------------------------------------------------------------

# 허용값: true | false
LAW_API_ENABLED=false
LAW_API_BASE_URL=https://www.law.go.kr
LAW_API_OC=
LAW_API_TIMEOUT_SECONDS=10

# Pinecone은 현재 확정 Runtime이 아니라 후보/선택적 Adapter다.
# 사용하지 않으면 비워 두고, 활성화할 때 Index Host와 Namespace를 함께 설정한다.
PINECONE_API_KEY=
PINECONE_INDEX_HOST=
PINECONE_NAMESPACE=
PINECONE_TIMEOUT_SECONDS=8

AGENTIC_RAG_CHAT_MODEL=gpt-4o-mini
AGENTIC_RAG_EMBEDDING_MODEL=text-embedding-3-small
AGENTIC_RAG_EMBEDDING_DIMENSIONS=1024
AGENTIC_RAG_MAX_CONTEXT_CHARS=6000
AGENTIC_RAG_LLM_FAILURE_THRESHOLD=3
AGENTIC_RAG_LLM_RECOVERY_SECONDS=30
AGENTIC_RAG_PROMPT_CACHE_TTL_SECONDS=604800
AGENTIC_RAG_EMBED_FAILURE_THRESHOLD=3
AGENTIC_RAG_EMBED_RECOVERY_SECONDS=30
AGENTIC_RAG_EMBED_CACHE_TTL_SECONDS=604800

# 허용값: vector | keyword | hybrid
AGENTIC_RAG_RETRIEVAL_MODE=vector


# ----------------------------------------------------------------------------
# 9. Profile 전용 Runtime 안내
# ----------------------------------------------------------------------------

# 아래 값들은 root .env가 아니라 각 Hermes Profile의 Runtime에 둔다.
#
#   ~/.hermes/profiles/ceo-agent/
#   ~/.hermes/profiles/hr-department/
#   ~/.hermes/profiles/research-department/
#   ~/.hermes/profiles/quant-backtest-department/
#   ~/.hermes/profiles/trading-department/
#   ~/.hermes/profiles/accounting-portfolio-department/
#   ~/.hermes/profiles/risk-management/
#   ~/.hermes/profiles/qa-department/
#
# 저장소 Profile:
#   departments/<n>/hermes/config.yaml
#   departments/<n>/hermes/SOUL.md
#
# 저장소 Profile과 실제 Runtime Profile은 별개다. auth.json, session, memory,
# state DB는 Git에 넣지 않는다. 동기화:
#   ./scripts/sync_hermes_profiles.sh push
#   ./scripts/sync_hermes_profiles.sh pull

# [Windows local only]
# Windows 호스트 경로를 사용하는 Compose Fragment에서만 필요하다.
# macOS/Linux/AWS에서는 비워 두거나 해당 호스트 경로를 사용하지 않는다.
USERPROFILE=


# ----------------------------------------------------------------------------
# 10. Observability
# ----------------------------------------------------------------------------

# 허용값: local | test | production | replay
APP_ENV=local
OTEL_SERVICE_NAME=hgfinance
OTEL_EXPORTER_OTLP_ENDPOINT=

# 허용값: 0 | 1 | false | true
RISK_QA_OTEL_ENABLED=0

# LangChain/LangSmith는 기본 비활성이다. 금융 데이터 외부 전송 정책과 비용을
# 검토한 뒤 필요한 환경에서만 활성화한다.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=

# 허용값: 0 | 1 | false | true
LANGFUSE_TRACING=false
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=


# ----------------------------------------------------------------------------
# 11. AWS / Host 전용 설정
# ----------------------------------------------------------------------------

AWS_REGION=ap-northeast-2
AWS_PROFILE=

# AWS에서는 Instance Role/Workload Identity를 우선한다.
# 아래 Access Key 방식은 local/test 임시 검증 외에는 사용하지 않는다.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

BEDROCK_MODEL_ID=
BEDROCK_EMBEDDING_MODEL_ID=

# [host-only] 직접 실행하는 스크립트의 내부 API Timeout
GOVERNANCE_API_TIMEOUT_SECONDS=8
