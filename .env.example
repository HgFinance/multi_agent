# ============================================================================
# HgFinance 저장소 Root 환경 변수 템플릿
#
# 사용법:
#   cp .env.example .env
#   $EDITOR .env
#   python scripts/configure_paper_order_env.py --runtime local
#   docker compose config --quiet
#
# 이 파일에는 변수명과 안전한 예시값만 둔다. 실제 Secret은 절대 커밋하지
# 않는다. `CHANGE_ME_*` 값은 서비스를 사용하기 전에 반드시 교체한다.
# 이 파일이 저장소의 유일한 환경 변수 템플릿이다. `.env.aws.template` 같은
# 환경별 복제본은 만들지 않는다. AWS는 비공개 runtime.env를 배포 스크립트와
# `configure_paper_order_env.py --runtime aws`로 정규화한다.
#
# 환경 구분:
#   local       개인 PC의 개발용 Compose
#   test        Fixture/Mock/Contract 검증용. 실제 Broker·운영 데이터 금지
#   production  AWS 운영 자문용. 실제 Broker 쓰기와 Live 승격은 별도 승인 필요
#
# 기본 원칙:
#   - Secret을 Log, Prompt, Frontend Bundle, Dataset에 넣지 않는다.
#   - Agent Container에는 Vendor API Key, 수집 DB Credential, Broker Credential을
#     넣지 않는다. Agent는 승인된 Domain API만 호출한다.
#   - local/test/production의 계정·Network·Secret·Data·Broker Credential을
#     분리한다. Replay 환경은 실제 Broker Credential을 가질 수 없다.
#   - AWS에서는 AWS Access Key 환경 변수보다 Instance Role/Workload Identity를
#     우선한다.
#
# 이 파일이 다루지 않는 영역:
#   1) Hermes Profile Runtime
#      ~/.hermes/profiles/<department>/.env 및 auth.json
#      저장소 Profile과 Runtime Profile의 동기화는
#      ./scripts/sync_hermes_profiles.sh 를 사용한다.
#   2) Frontend Cloudflare Worker
#      ai-office/.dev.vars.example을 사용하고, 배포 Secret은 wrangler secret으로
#      주입한다.
# ============================================================================


# ----------------------------------------------------------------------------
# 1. Compose 필수 Database 설정
# ----------------------------------------------------------------------------

# [local/test/production]
# Supabase 또는 해당 환경의 PostgreSQL DSN이다.
# Agent가 직접 사용하지 않고 Backend/Domain API가 사용한다.
DATABASE_URL=postgresql://DB_USER:CHANGE_ME_DB_PASSWORD@DB_HOST:5432/DB_NAME
ACCOUNTING_DATABASE_POOL_MAX=8

# [AWS deployment]
# deploy/eb/docker-compose.yml receives this private operational PostgreSQL DSN
# and maps it to DATABASE_URL inside each application container.
CONTROL_DATABASE_URL=postgresql://DB_USER:CHANGE_ME_DB_PASSWORD@PRIVATE_DB_HOST:5432/DB_NAME

# [local host tools]
# Direct host launchers and factory_e2e use only this explicit local contract;
# they never fall back to DATABASE_URL. Supabase CLI's default DB port is 54322.
LOCAL_CONTROL_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# [선택, 권장] quant-api 전용 최소 권한 롤의 DSN이다. 비어 있으면
# DATABASE_URL로 이전 호환되며 Hermes 컨테이너에는 어느 DSN도 전달하지 않는다.
QUANT_DATABASE_URL=

# [local]
# 로컬 TimescaleDB 컨테이너의 관리자 비밀번호다.
# Compose가 컨테이너 내부 DSN을 자동으로 조합한다.
HEDGEFUND_TSDB_PASSWORD=CHANGE_ME_TSDB_PASSWORD
# AWS private control-plane LOGIN passwords. The configuration script creates
# independent URL-safe values; never reuse any service-auth secret here.
HEDGEFUND_RUNTIME_DB_PASSWORD=
HEDGEFUND_ORDER_DB_PASSWORD=
HEDGEFUND_TRADING_DB_PASSWORD=
HEDGEFUND_ACCOUNTING_DB_PASSWORD=
HEDGEFUND_CONDITIONAL_ORCHESTRATOR_DB_PASSWORD=
HEDGEFUND_CONDITIONAL_WORKER_DB_PASSWORD=

# [migration/admin only]
# 일반 수집기에는 주입하지 않는다. 사용자 인증 전용화가 끝나면 service-role은
# 별도 관리자 secret으로만 보관한다.
SUPABASE_URL=https://CHANGE_ME_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=CHANGE_ME_SUPABASE_SERVICE_ROLE_KEY

# Research MCP의 요청시 뉴스 조회에만 쓰며, 어떤 상주 수집기에도 주입하지 않는다.
NAVER_CLIENT_ID=CHANGE_ME_NAVER_CLIENT_ID
NAVER_CLIENT_SECRET=CHANGE_ME_NAVER_CLIENT_SECRET

# [선택] Frontend/읽기 전용 클라이언트 값이다.
# SERVICE_ROLE_KEY나 DATABASE_URL을 대신하지 않는다.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_DATABASE_URL=
SUPABASE_PASSWORD=

# [host-only]
# 호스트에서 TimescaleDB를 직접 조회할 때만 사용한다.
# Compose 서비스 내부에서는 HEDGEFUND_TSDB_PASSWORD로 DSN을 만든다.
TIMESCALE_DATABASE_URL=postgresql://postgres:CHANGE_ME_TSDB_PASSWORD@127.0.0.1:5434/market


# ----------------------------------------------------------------------------
# 2. CEO / Kanban / Portfolio BFF
# ----------------------------------------------------------------------------

# [local/test/production]
# portfolio-bff에서 ceo-hermes API로 보내는 공유 인증값이다.
CEO_HERMES_API_KEY=CHANGE_ME_CEO_HERMES_API_KEY

# 허용값: true | false
# 대표 지시창 POST /ui/ceo/ask를 활성화한다.
ENABLE_AGENT_ASK=true

# 허용값: 1 | 0
# BFF가 공용 Hermes Kanban 보드에 사용자 질의를 기록할지 정한다.
ENABLE_KANBAN_TASK_TRACKING=1

# [컨테이너 내부 경로]
HERMES_BIN=/usr/local/bin/hermes
HERMES_HOME=/opt/hermes-cli
HERMES_KANBAN_HOME=/opt/kanban
HERMES_CEO_API_URL=http://ceo-hermes:8642/v1

# 허용값: deterministic | llm
# 기본값은 deterministic이다. LLM 기반 CEO Task Planner는 별도 검증 후 활성화한다.
PORTFOLIO_CEO_TASK_PLANNER_MODE=deterministic

# Dispatcher-owned fast_advisory worker budget only; standard/experiment
# workers retain their profile-configured turn limits.
HGFINANCE_FAST_ADVISORY_MAX_TURNS=32

# [선택] CEO Hermes API 요청에 기록할 모델 표시명이다.
HERMES_CEO_API_MODEL=hermes-agent

# [local/test/production]
# BFF를 호스트에 게시할 포트다.
PORTFOLIO_BFF_PORT=8001

# 허용값: true | false
# 거버넌스 Mandate와 Portfolio Runtime을 연결할지 정한다.
PORTFOLIO_GOVERNANCE_BINDING_ENABLED=false
GOVERNANCE_API_URL=
GOVERNANCE_API_AUTH_TOKEN=
GOVERNANCE_WORKFORCE_DATABASE_URL=
GOVERNANCE_EVENT_POLL_INTERVAL_SECONDS=1

# Portfolio Worker 설정
PORTFOLIO_WORKER_POLL_SECONDS=0.5
PORTFOLIO_WORKER_LEASE_SECONDS=60
PORTFOLIO_RUNTIME_STORE_PATH=/var/lib/portfolio/runtime.sqlite3

# 허용값: true | false
# 기본값은 false다. API와 Worker를 분리하고 Worker만 Queue를 claim한다.
PORTFOLIO_RUNTIME_EMBEDDED_WORKER=false
PORTFOLIO_RUNTIME_STORE_DIR=/tmp
PORTFOLIO_GOVERNANCE_BINDING_PATH=/governance/v1/mandates/{mandate_id}/current
# 사용자 인증 경계. local/test fixture는 두 값을 명시해야만 X-User-Id를
# 허용한다. AWS/production은 supabase_jwt + true를 사용한다.
PORTFOLIO_AUTH_MODE=fixture
PORTFOLIO_AUTH_REQUIRED=false
# Set true only in a deployment that also runs the shared Kanban dispatcher,
# Trading Hermes profile, and authenticated PAPER-order MCP bridge.
USER_PAPER_ORDER_WORKFLOW_ENABLED=false
USER_PAPER_ORDER_DETERMINISTIC_FAST_PATH_ENABLED=false
# Test/local fixture only. Production fixture mode is rejected before use.
# Each row must explicitly bind user_id/fund_id/book_id/name/role and ACTIVE statuses.
PORTFOLIO_FIXTURE_TRADING_BOOKS_JSON=[]
# Comma-separated exact origins. Production accepts HTTPS only and no wildcard.
PORTFOLIO_CORS_ALLOW_ORIGINS=http://localhost:3000
# 비우면 SUPABASE_URL에서 issuer와 JWKS URL을 안전하게 유도한다.
SUPABASE_AUTH_ISSUER=
SUPABASE_AUTH_JWKS_URL=
SUPABASE_AUTH_AUDIENCE=authenticated
PORTFOLIO_REQUIRE_MANDATE_BINDING=false
UI_SNAPSHOT_CACHE_SECONDS=2

# Browser -> portfolio-bff -> trading-api user-directive boundary. Generate one
# random value of at least 32 bytes and inject the same value into both services
# from a secret manager. It is not a Supabase key and is never exposed to UI.
TRADING_API_URL=http://trading-api:8000
# Required for PAPER user directives. Generate a private random value of at
# least 32 bytes; startup rejects empty and placeholder values.
# KEEP: User-order and BFF-to-Trading authentication boundary.
TRADING_SERVICE_AUTH_SECRET=
TRADING_SERVICE_AUTH_ISSUER=portfolio-bff
TRADING_SERVICE_AUTH_AUDIENCE=trading-api
# Independent verifier for internal service-to-service OMS mutations. Do not
# expose this value to any Hermes profile or browser-facing process.
# KEEP: Trading internal service-to-service authentication.
TRADING_INTERNAL_SERVICE_AUTH_SECRET=
TRADING_INTERNAL_SERVICE_AUTH_ISSUER=hedgefund-service-issuer
TRADING_INTERNAL_SERVICE_AUTH_AUDIENCE=trading-api
# Authenticated user directives are intentionally PAPER-only. Production must
# use the durable local/private operational PostgreSQL repository and the
# least-privilege role created by migration 20260818001500.
TRADING_EXECUTION_MODE=PAPER
TRADING_BROKER_ADAPTER=paper
TRADING_DIRECTIVE_REPOSITORY=postgres
TRADING_DATABASE_ROLE=svc_trading_api
ORDER_ORCHESTRATOR_DATABASE_ROLE=svc_order_orchestrator
CONDITIONAL_RULE_DATABASE_URL=
CONDITIONAL_RULE_DATABASE_ROLE=svc_conditional_rule_orchestrator
CONDITIONAL_RULE_WORKER_DATABASE_ROLE=svc_conditional_rule_worker
CONDITIONAL_RULE_WORKER_POLL_SECONDS=1.0
CONDITIONAL_RULE_WORKER_BATCH_SIZE=100
CONDITIONAL_RULE_HTTP_TIMEOUT_SECONDS=8
CONDITIONAL_RULE_RETENTION_DATABASE_URL=
CONDITIONAL_RULE_RETENTION_DATABASE_ROLE=svc_conditional_rule_worker
CONDITIONAL_RULE_RETENTION_ENABLED=true
CONDITIONAL_RULE_RETENTION_INTERVAL_SECONDS=86400
CONDITIONAL_RULE_RETENTION_BATCH_SIZE=500
CONDITIONAL_RULE_EVALUATION_RETENTION_DAYS=30
CONDITIONAL_RULE_DETAIL_RETENTION_DAYS=90
CONDITIONAL_RULE_OUTBOX_RETENTION_DAYS=7
CONDITIONAL_RULE_RETENTION_STATEMENT_TIMEOUT_MS=1500
TRADING_AUTH_MODE=service
TRADING_MARKET_QUOTE_MAX_AGE_SECONDS=10
TRADING_MARKET_QUOTE_FUTURE_SKEW_SECONDS=2
TRADING_PAPER_BUY_COST_BUFFER_BPS=100

# The durable fill consumer reduces the shared operational PostgreSQL login to
# this NOLOGIN role at the start of every transaction.
ACCOUNTING_DATABASE_ROLE=svc_accounting_ledger


# ----------------------------------------------------------------------------
# 3. Redis / Event Worker
# ----------------------------------------------------------------------------

# [local]
# Compose 네트워크 안에서는 localhost가 아니라 서비스명 redis를 사용한다.
REDIS_URL=redis://redis:6379/0
RISK_QA_EVENT_REDIS_URL=redis://redis:6379/0

#------------------------------------------------------------------------------
# 5-1. Web/Discord CEO 미러링  [NOW]
#
# 기존 Compose Redis를 request/event dedup과 공용 CEO timeline 저장소로 사용한다.
# AWS 운영에서는 REDIS_URL 또는 UI_MIRROR_REDIS_URL 중 하나를 반드시 설정한다.
#
# 환경 선택:
#   local/test   Redis가 없으면 단위 테스트에서 InMemoryMirrorStore를 명시적으로 주입
#   production   AWS 기존 Redis URL 사용. dedup 저장소 장애 시 CEO 실행을 503으로 차단
#------------------------------------------------------------------------------
UI_MIRROR_REDIS_URL=
UI_MIRROR_STREAM=hf:ui-ceo-mirror:v1
UI_MIRROR_DEDUPE_TTL_SECONDS=604800
UI_MIRROR_DEDUPE_WAIT_SECONDS=3
UI_MIRROR_SSE_SECONDS=25
RISK_QA_EVENT_DEDUPE_TTL_SECONDS=604800
RISK_QA_EVENT_STREAM=risk-qa-events
QA_EVENT_GROUP=qa-workers
QA_EVENT_CONSUMER=qa-api
QA_EVENT_POLL_INTERVAL_SECONDS=1

WORKFORCE_EVENT_POLL_INTERVAL_SECONDS=1
WORKFORCE_EVENT_DEDUPE_TTL_SECONDS=604800
WORKFORCE_EVENT_STREAM=hf:workforce
WORKFORCE_EVENT_GROUP=workforce-api
WORKFORCE_EVENT_CONSUMER=workforce-api

RELAY_POLL_SECONDS=1.0
RELAY_MAX_ATTEMPTS=12
LEDGER_CONSUMER_POLL_SECONDS=1.0
ACCOUNTING_MARK_INTERVAL=

# [컨테이너 내부 URL]
MARKET_API_URL=http://market-api:8036
RESEARCH_API_URL=http://research-api:8035


# ----------------------------------------------------------------------------
# 4. Research MCP / 외부 Data Source
# ----------------------------------------------------------------------------

# 키가 없는 Source는 해당 MCP 도구가 fail-closed 한다.
TAVILY_API_KEY=
OPEN_DART_API_KEY=
KRX_API_KEY=
BIGKINDS_API_KEY=
ECOS_API_KEY=
KOSIS_API_KEY=
FRED_API_KEY=
UNPAYWALL_EMAIL=

# [local/test/production]
# Research MCP 호출 인증값이다. 공유 환경에서는 비워 두지 않는다.
MCP_RESEARCH_API_KEY=CHANGE_ME_MCP_RESEARCH_API_KEY
RESEARCH_MCP_PORT=8037

# Trading Hermes -> trusted PAPER-order orchestrator MCP. Generate an
# independent random value of at least 32 bytes. The server rejects empty,
# short, and placeholder values; never reuse a Trading service-proof secret.
# KEEP: PAPER-order MCP authentication.
MCP_TRADING_ORDER_API_KEY=CHANGE_ME_MCP_TRADING_ORDER_API_KEY

# 허용값: true | false
# false는 관측 모드, true는 Tool Gateway 허용목록 위반을 차단한다.
TOOL_GATEWAY_ENFORCE=false
TOOL_GATEWAY_ENFORCE_MARKET=false

# ----------------------------------------------------------------------------
# 5. LS증권 Open API
# ----------------------------------------------------------------------------

# 허용값: PAPER | LIVE
# 시장·계좌 조회가 함께 사용하는 단일 LS 환경이다. 기본은 PAPER이며 LIVE는
# Production Launch Gate 통과와 별도 승인 후에만 사용한다.
LS_ENV=PAPER

# 실전투자(LIVE) Credential / Endpoint
# LS_ENV=LIVE일 때만 사용한다.
LS_APP_KEY=
LS_APP_SECRET_KEY=
LS_REST_BASE_URL=https://openapi.ls-sec.co.kr:8080
LS_WS_BASE_URL=wss://openapi.ls-sec.co.kr:9443

# 모의투자(PAPER) Credential / Endpoint
# LS_ENV=PAPER일 때만 사용한다. Live 값과 절대 섞지 않는다.
LS_APP_KEY_PAPER=
LS_APP_SECRET_KEY_PAPER=
LS_REST_BASE_URL_PAPER=
LS_WS_BASE_URL_PAPER=wss://openapi.ls-sec.co.kr:29443

# Paper 계좌 Credential
# 계좌번호는 비워 두는 것이 정상이다 - appkey에 묶인 계좌를 `CSPAQ12200`이
# 되돌려 주므로 BFF가 알아서 채운다. 계좌가 여럿일 때만 명시로 덮어쓴다.
LS_ACCOUNT_NO_PAPER=
LS_ACCOUNT_PWD_PAPER=

# Live 계좌 Credential은 계좌가 여러 개일 때만 명시한다.
LS_ACCOUNT_NO=
LS_ACCOUNT_PWD=
LS_MAC_ADDRESS=
LS_OAUTH_SCOPE=oob

# 브로커 계좌 실시간 파이프라인(`/ui/portfolio/live`).
# 켜면 BFF가 LS WebSocket에 계좌등록하고 주문 접수·체결·정정·취소·거부와
# 체결 후 잔고 동기화(t0424)를 받는다.
# 읽기 전용이다 - 이 스위치로 주문이 나가지는 않는다.
ENABLE_LS_ORDER_EVENTS=false
# REST 시장 순위(`/ui/market/rankings`)만 계좌 WebSocket 없이 켠다.
ENABLE_LS_MARKET_DATA=false
# REST 거래내역·잔고 조회(`/ui/portfolio/ledger`)만 계좌 WebSocket 없이 켠다.
ENABLE_LS_ACCOUNT_DATA=false

# 회계 원장 durable 저장소 경로. 비우면 저장하지 않는다.
# 체결일과 결제일(T+2) 사이에는 어떤 브로커 조회로도 그 거래를 다시
# 가져올 수 없어서, 본 것을 여기 적어 두지 않으면 날짜가 바뀔 때 장부가 빈다.
ACCOUNTING_LEDGER_DB=var/accounting_ledger.sqlite3


# ----------------------------------------------------------------------------
# 6. Local Model / Worker Runtime
# ----------------------------------------------------------------------------

# [host process]
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# [Docker Linux/Windows 호환]
OLLAMA_DOCKER_BASE_URL=http://host.docker.internal:11434/v1

# [현재 Prototype]
# 허용값 예시: qwen3:1.7b
OLLAMA_CHAT_MODEL=qwen3:1.7b
OLLAMA_EMBEDDING_MODEL=
OLLAMA_TIMEOUT_SECONDS=8
OLLAMA_API_KEY=ollama
PORTFOLIO_WORKER_RUNTIME=ollama

# [AWS/model overlay] shared non-binding Worker model plane. Leave the base
# URL empty for local Ollama fallback; docker-compose.model.yml supplies the
# vLLM default when that GPU overlay is explicitly enabled.
WORKER_MODEL_BASE_URL=
# Host-side E2E/worker processes use the loopback-published vLLM endpoint;
# containers keep WORKER_MODEL_BASE_URL=http://vllm:8000/v1.
WORKER_MODEL_HOST_BASE_URL=http://127.0.0.1:8000/v1
WORKER_MODEL_EXECUTION_CONTEXT=host
WORKER_MODEL_NAME=qwen2.5-14b-instruct-awq
WORKER_MODEL_API_KEY=vllm
WORKER_MODEL_TIMEOUT_SECONDS=120
WORKER_MODEL_REGISTRY_PATH=/app/departments/01-research/config/worker_model_registry.json
# AWS AWQ v1 runtime adapter. The directory must contain the adapter files
# before the model overlay is started.
WORKER_MODEL_PROFILE=qwen-awq-v1
WORKER_LORA_ADAPTER_NAME=hgfinance-awq-arithmetic-2epoch
WORKER_LORA_ADAPTER_VERSION=arithmetic-2epoch
WORKER_LORA_ADAPTER_DIR=/tmp/hgfinance-awq-specialists-v1/arithmetic/adapter-2epoch
# Image used only by model fetch/quantization helper scripts. Serving Compose
# is pinned literally in docker-compose.model.yml and ignores this override.
VLLM_IMAGE=vllm/vllm-openai@sha256:0a51ea5b4ae2dc5d81890e5173f54203d2a3ae0cfffe51b8fd2afd4391bfd967
# Optional host-side vLLM/Torch compile cache. Keep it on the runtime disk so
# restarts do not repeat the cold compile memory spike.
VLLM_CACHE_DIR=

# Risk/QA 직접 실행용 Provider Key
# Hermes Profile의 Provider Credential은 이 파일에 넣지 않는다.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=


# ----------------------------------------------------------------------------
# 7. Risk / QA / Accounting 환경 선택
# ----------------------------------------------------------------------------

# 허용값: test | production
# test는 Fixture/Mock 기반 검증, production은 외부 데이터와 실제 계약 검증이다.
# production 전환은 Preflight와 승인 절차를 통과해야 한다.
RISK_QA_RUNTIME=test

# 허용값: test | production
RISK_DATA_MODE=test

# 허용값: true | false
RISK_REQUIRE_P1_ANALYTICS=false
RISK_QA_PRODUCTION_ENABLED=false

# 허용값: request | database | artifact
RISK_CONTEXT_SOURCE=request

# 허용값 예시: paper | live | mock | 빈 값
RISK_BROKER_ADAPTER=
RISK_EXTERNAL_API_TIMEOUT_SECONDS=5
RISK_QA_DATABASE_URL=

# Risk/QA Domain API 서명 토큰
# [local/test/production] 환경별로 서로 다른 값을 사용한다.
RISK_SERVICE_AUTH_SECRET=CHANGE_ME_RISK_SERVICE_SECRET
RISK_SERVICE_AUTH_ISSUER=hgfinance-risk
RISK_SERVICE_AUTH_AUDIENCE=hgfinance-internal
QA_SERVICE_AUTH_SECRET=CHANGE_ME_QA_SERVICE_SECRET
QA_SERVICE_AUTH_ISSUER=hgfinance-qa
QA_SERVICE_AUTH_AUDIENCE=hgfinance-internal

# 허용값: test | production
# QA 문서/정책 Corpus 적재 모드다.
# Non-market evidence is fetched through MCP at request time and is not persisted.
QA_INGEST_MODE=disabled
QA_ENABLE_LEGACY_EVIDENCE_INGESTION=false
# Legacy one-off migration only; normal runtime leaves this empty.
QA_POLICY_SOURCE_ID=
QA_CHECK_CONTRACT_APPROVED=false
QA_POLICY_CORPUS_DIR=
QA_EVIDENCE_CORPUS_DIR=

# 허용값: true | false
QA_TRACE_PERSIST=false

# 허용값: true | false
# true이면 Incident Timeline을 DATABASE_URL 또는 RISK_QA_DATABASE_URL에 영속화한다.
QA_INCIDENT_PERSIST=false

# Accounting 실행 모드
# 허용값: OFFLINE | PAPER_DB | DURABLE | PRODUCTION | LIVE_DB
ACCOUNTING_MODE=PAPER_DB

# 허용값: true | false
PAPER_DB=true
DISCORD_WEBHOOK_URL=
# 웹훅은 쓰기 전용이다. 채널 히스토리 조회에는 Bot 토큰이 따로 필요하다
# (GET /channels/{id}/messages, 봇에 Read Message History 권한 필요).
DISCORD_CEO_CHANNEL_ID=
DISCORD_BOT_TOKEN_CEO=
DISCORD_MIRROR_ENABLED=false
# Generated/preserved by scripts/configure_paper_order_env.py. This bearer is
# shared only by ceo-hermes and portfolio-bff and must not reuse another key.
# KEEP: BFF Discord ingress authentication.
CEO_DISCORD_INGRESS_API_KEY=
# Comma/whitespace-separated discord_user_id:user_uuid[:fund_uuid] bindings.
# AWS PAPER deployment requires one three-field binding matching its seed pair.
DISCORD_ACTOR_MAP=
DISCORD_BOT_TOKEN_HR=
DISCORD_BOT_TOKEN_RESEARCH=
DISCORD_BOT_TOKEN_QUANT=
DISCORD_BOT_TOKEN_ACCOUNTING=
DISCORD_BOT_TOKEN_TRADING=
DISCORD_BOT_TOKEN_RISK=
DISCORD_BOT_TOKEN_QA=
ACCOUNTING_DEFAULT_BOOK_ID=

# Notion projection used by the CEO/department reporting path. These values
# are runtime-only and must never be committed with real credentials.
NOTION_TOKEN=
NOTION_CEO_DB=
NOTION_BRIEFING_DB=
NOTION_RESEARCH_DB=
NOTION_TRADING_DB=
NOTION_RISK_DB=
NOTION_QUANT_BACKTEST_DB=
NOTION_ACCOUNTING_DB=
NOTION_QA_DB=
NOTION_HR_DB=

# 내부 Domain API URL
RISK_API_URL=http://127.0.0.1:8041
RISK_API_AUTH_TOKEN=
RISK_API_TIMEOUT_SECONDS=8
QA_API_URL=http://127.0.0.1:8042
# Compose-internal override for portfolio-bff -> audit-api. Leave empty to use
# the service name fallback in docker-compose.yml; do not use 127.0.0.1 here.
QA_API_INTERNAL_URL=
# Service bearer for BFF -> audit-api feedback routes. It must carry
# qa.observability.read, qa.observability.approve, and
# qa.observability.benchmark scopes.
QA_API_AUTH_TOKEN=
QA_API_TIMEOUT_SECONDS=8
WORKFORCE_API_URL=http://127.0.0.1:8044
WORKFORCE_API_TIMEOUT_SECONDS=30


# ----------------------------------------------------------------------------
# 8. 법률 / Policy / Vector RAG
# ----------------------------------------------------------------------------

# 허용값: true | false
LAW_API_ENABLED=false
LAW_API_BASE_URL=https://www.law.go.kr
LAW_API_OC=
LAW_API_TIMEOUT_SECONDS=10

# Pinecone은 현재 확정 Runtime이 아니라 후보/선택적 Adapter다.
# 사용하지 않으면 비워 두고, 활성화할 때 Index Host와 Namespace를 함께 설정한다.
PINECONE_API_KEY=
PINECONE_INDEX_HOST=
PINECONE_NAMESPACE=
PINECONE_TIMEOUT_SECONDS=8

AGENTIC_RAG_CHAT_MODEL=gpt-4o-mini
AGENTIC_RAG_EMBEDDING_MODEL=text-embedding-3-small
AGENTIC_RAG_EMBEDDING_DIMENSIONS=1024
AGENTIC_RAG_MAX_CONTEXT_CHARS=6000
AGENTIC_RAG_LLM_FAILURE_THRESHOLD=3
AGENTIC_RAG_LLM_RECOVERY_SECONDS=30
AGENTIC_RAG_PROMPT_CACHE_TTL_SECONDS=604800
AGENTIC_RAG_EMBED_FAILURE_THRESHOLD=3
AGENTIC_RAG_EMBED_RECOVERY_SECONDS=30
AGENTIC_RAG_EMBED_CACHE_TTL_SECONDS=604800

# 허용값: vector | keyword | hybrid
AGENTIC_RAG_RETRIEVAL_MODE=vector


# ----------------------------------------------------------------------------
# 9. Profile 전용 Runtime 안내
# ----------------------------------------------------------------------------

# 아래 값들은 root .env가 아니라 각 Hermes Profile의 Runtime에 둔다.
#
#   ~/.hermes/profiles/ceo-agent/
#   ~/.hermes/profiles/hr-department/
#   ~/.hermes/profiles/research-department/
#   ~/.hermes/profiles/quant-backtest-department/
#   ~/.hermes/profiles/trading-department/
#   ~/.hermes/profiles/accounting-portfolio-department/
#   ~/.hermes/profiles/risk-management/
#   ~/.hermes/profiles/qa-department/
#
# 저장소 Profile:
#   departments/<n>/hermes/config.yaml
#   departments/<n>/hermes/SOUL.md
#
# 저장소 Profile과 실제 Runtime Profile은 별개다. auth.json, session, memory,
# state DB는 Git에 넣지 않는다. 동기화:
#   ./scripts/sync_hermes_profiles.sh push
#   ./scripts/sync_hermes_profiles.sh pull

# [Windows local only]
# Windows 호스트 경로를 사용하는 Compose Fragment에서만 필요하다.
# macOS/Linux/AWS에서는 비워 두거나 해당 호스트 경로를 사용하지 않는다.
USERPROFILE=


# ----------------------------------------------------------------------------
# 10. Observability
# ----------------------------------------------------------------------------

# 허용값: local | test | production | replay
APP_ENV=local
OTEL_SERVICE_NAME=hgfinance
OTEL_EXPORTER_OTLP_ENDPOINT=

# 허용값: 0 | 1 | false | true
RISK_QA_OTEL_ENABLED=0

# LangSmith production workflow traces are the shared request-tree source of
# truth. Metric/eval projects below are separate read paths; tracing is off by
# default.
LANGSMITH_TRACING=false

# MemoHarness-lite D5 Experience Bank.  off preserves the existing D4-only
# behavior; shadow records/retrieves without changing planner prompts; active
# allows only bounded structured hints into the existing CEO planner.
MEMOHARNESS_D5_MODE=off
MEMOHARNESS_D5_TOP_K=5
MEMOHARNESS_D5_STATEMENT_TIMEOUT_MS=1500
# Optional dedicated private Postgres DSN. If empty, CONTROL_DATABASE_URL /
# DATABASE_URL is used by the fail-open adapter.
MEMOHARNESS_D5_DATABASE_URL=
# D5 retention is isolated from Kanban retention and only touches
# experience.workflow_experiences. Cleanup is daily, batched, and fail-open.
MEMOHARNESS_D5_RETENTION_ENABLED=true
MEMOHARNESS_D5_RETENTION_INTERVAL_SECONDS=86400
MEMOHARNESS_D5_RETENTION_BATCH_SIZE=500
MEMOHARNESS_D5_RETENTION_MAX_PRESSURE_BATCHES=10
MEMOHARNESS_D5_RETENTION_VACUUM_ANALYZE=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=First
# High-frequency, empty-payload worker performance metrics. These are kept
# separate from the production request trace tree.
LANGSMITH_METRICS_PROJECT=HgFinance-Metrics
# Reserved for benchmark/evaluation producers; production workflow code must
# continue to use LANGSMITH_PROJECT.
LANGSMITH_EVALS_PROJECT=HgFinance-Evals
# LangSmith feedback loop: shadow evaluates metadata-only traces without
# changing business flow; active additionally exposes QA-approved bounded hints
# to a later CEO planning request.  off disables the background evaluator.
LANGSMITH_FEEDBACK_MODE=shadow
LANGSMITH_FEEDBACK_STATE_PATH=/var/lib/portfolio/langsmith-feedback.sqlite3
LANGSMITH_FEEDBACK_POLL_SECONDS=30
LANGSMITH_FEEDBACK_LOOKBACK_SECONDS=900
LANGSMITH_FEEDBACK_BATCH_SIZE=25
LANGSMITH_FEEDBACK_MAX_PENDING=500
LANGSMITH_FEEDBACK_RETENTION_DAYS=30
LANGSMITH_FEEDBACK_LATENCY_WARN_MS=60000
LANGSMITH_FEEDBACK_MAX_ITEMS=3
LANGSMITH_FEEDBACK_MAX_CHARS=1200
LANGSMITH_FEEDBACK_METRICS_WINDOW_SECONDS=300
LANGSMITH_FEEDBACK_METRICS_MAX_RUNS=100

# 허용값: 0 | 1 | false | true
LANGFUSE_TRACING=false
# 리전별 호스트가 다르고 키는 만들어진 리전에서만 유효하다 - US:
# https://cloud.langfuse.com, EU: https://eu.cloud.langfuse.com, JP:
# https://jp.cloud.langfuse.com. 리전을 틀리면 401 이라 HR 관측이 조용히
# 전원 UNAVAILABLE 로 떨어진다. 코드가 읽는 이름은 LANGFUSE_HOST 하나뿐이다
# (Langfuse UI 는 LANGFUSE_BASE_URL 로 안내하지만 이 저장소는 안 읽는다).
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=


# ----------------------------------------------------------------------------
# 11. AWS / Host 전용 설정
# ----------------------------------------------------------------------------

AWS_REGION=ap-northeast-2
AWS_PROFILE=

# AWS에서는 Instance Role/Workload Identity를 우선한다.
# 아래 Access Key 방식은 local/test 임시 검증 외에는 사용하지 않는다.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

BEDROCK_MODEL_ID=
BEDROCK_EMBEDDING_MODEL_ID=

# [host-only] 직접 실행하는 스크립트의 내부 API Timeout
GOVERNANCE_API_TIMEOUT_SECONDS=8

# ── 관측(Prometheus/Grafana) ────────────────────────────────────────────
# 외부 서비스 계정이 아니다. 셀프호스트 Grafana 의 admin 비밀번호 그 자체다.
# docker-compose.observability.yml 이 없으면 읽지 않는다.
GRAFANA_PASSWORD=
