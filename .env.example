#==============================================================================
# Personal Hedge Fund Agent — 저장소 Root 환경 변수 템플릿
#
#   cp .env.example .env      # .env 는 .gitignore 에 있다. 커밋하지 않는다.
#
# 이 파일(.env.example)만 Version 관리한다.
# 근거: docs/02-engineering/TECH_STACK_DECISIONS.md 12절 "Secret과 설정"
#
# 규칙
#   - 실제 Key를 .env, Log, Prompt, Frontend Bundle, Dataset에 넣지 않는다.
#   - 환경 변수 평문 Secret은 Local Development로 제한한다.
#   - Pydantic Settings로 검증하고 시작 시 누락을 실패 처리한다.
#   - Agent Container에는 Vendor API Key, 수집 DB Credential, Broker
#     Credential을 넣지 않는다. Agent는 승인된 Domain API만 호출한다.
#   - 환경별(local/paper/live) 계정·Network·Secret·Data·Broker Credential을
#     완전히 분리한다. Replay 환경은 실제 Broker Credential을 가질 수 없다.
#
# ▶ 이 파일이 다루지 않는 두 곳 (중복해서 넣지 말 것)
#   1) Hermes 부서 Runtime — ~/.hermes/profiles/<department>/.env
#      departments/<n>/hermes/config.yaml 의 env: 블록이 참조하는
#      실제 값은 이 저장소가 아니라 Hermes 로컬 Profile에 있다.
#      저장소 사본 ↔ 로컬 Runtime 동기화는 ./scripts/sync_hermes_profiles.sh
#   2) ai-office (Cloudflare Workers) — ai-office/.dev.vars.example
#      Notion / Discord 연동 값. 배포는 파일이 아니라 wrangler secret put.
#
# 상태 표기
#   [NOW]  이 저장소의 실행 가능한 코드가 지금 읽는 값
#   [SPEC] 문서가 정한 P0/P1 Source. 아직 이를 읽는 코드가 없다
#==============================================================================


#------------------------------------------------------------------------------
# 1. 부서 Agent LLM Key  [NOW]
#
# 부서마다 배정된 Provider가 다르다.
# departments/<n>/hermes/config.yaml 의 env: 블록과 반드시 일치시킨다.
#
#   ANTHROPIC_API_KEY -> 00-ceo-office, 01-research,
#                        06-ai-qa-audit, 04-quant-backtest
#   OPENAI_API_KEY    -> 02-trading, 03-risk,
#                        05-accounting-portfolio, 07-agent-workforce
#
# skills/agentic-rag 도 OPENAI_API_KEY 를 쓴다 (Domain Owner가 03-risk라서).
# 부서 Agent를 Hermes로 돌릴 때는 위 "이 파일이 다루지 않는 두 곳" 1번을 볼 것.
#------------------------------------------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# requirements.txt 가 google-genai 를 포함한다. Gemini를 쓰지 않으면 비워 둔다.
GOOGLE_API_KEY=

# 8개 config.yaml 이 model.provider: nous / poolside/laguna-s-2.1:free 를 선언한다.
# Nous Portal은 `hermes setup --portal` OAuth 로그인으로 붙이며, 토큰은 이 파일이 아니라
# 각 Profile의 ~/.hermes/profiles/<department>/auth.json 에 저장된다.
# 따라서 평문 Key 변수는 두지 않는다. API Key 방식이 필요해지면 그때 변수명을 확인한다.
# NOUS_API_KEY=


#------------------------------------------------------------------------------
# 2. 뉴스 조회  [NOW]  — departments/01-research/collectors/news.py
#
# 환경 변수가 있으면 그것을 먼저 쓰고, 없을 때만 이 .env 를 직접 파싱한다.
# 즉 셸에서 export/setx 로 넣어두면 이 파일에 없어도 동작한다.
#------------------------------------------------------------------------------
TAVILY_API_KEY=


#------------------------------------------------------------------------------
# 3. Agentic RAG 튜닝  [NOW]  — 선택. 비우면 아래 기본값이 쓰인다.
#
# skills/agentic-rag/src/nodes.py, src/retriever.py
#------------------------------------------------------------------------------
AGENTIC_RAG_CHAT_MODEL=gpt-4o-mini
AGENTIC_RAG_EMBEDDING_MODEL=text-embedding-3-small
AGENTIC_RAG_EMBEDDING_DIMENSIONS=1024

# Risk external data adapters (read-only; never put production keys in Git)
RISK_QA_RUNTIME=test
RISK_DATA_MODE=test
RISK_EXTERNAL_API_TIMEOUT_SECONDS=5
LS_ENV=PAPER
LS_APP_KEY_PAPER=
LS_APP_SECRET_KEY_PAPER=
LS_REST_BASE_URL_PAPER=
LS_ACCOUNT_NO_PAPER=
LS_ACCOUNT_PWD_PAPER=
LS_MAC_ADDRESS=
LS_OAUTH_SCOPE=oob

# QA policy ingestion / pgvector (required only for a real ingestion run)
QA_INGEST_MODE=production
QA_POLICY_SOURCE_ID=
QA_CHECK_CONTRACT_APPROVED=false

#------------------------------------------------------------------------------
# 3-1. LangSmith Tracing  [임시 — 동규님 risk/qa 부서 유휴 에이전트 점검용]
#
# LANGSMITH_TRACING=true 로 이 셸에 로드된 동안 실행되는 모든 langgraph 파이프라인이
# 자동 추적된다 — 부서별 격리가 코드로 되어있지 않다. departments/03-risk/scripts.py --run,
# departments/06-ai-qa-audit/scripts.py --run (+ skills/agentic-rag)만 이 env가 로드된
# 셸에서 실행할 것 — research 등도 langgraph를 쓰므로 같은 프로젝트에 섞인다.
#
# 2026-08-02 방향 결정(HR 유휴 Agent 리포팅 파이프라인, 아직 미구현): 만들 때는 LangSmith 원문
# Trace를 그대로 인사팀(07-agent-workforce)에 넘기지 않는다 — compliance-policy-agent Trace엔
# Mandate/Restricted List 질의응답 같은 Risk/Compliance 내용이 그대로 담긴다. risk/qa notion_report
# 노드와 같은 fail-safe/non-blocking Reporter 패턴으로, 토큰량·Latency·에러율 집계 지표만 전달한다.
# 실제 파이프라인(LangSmith API 조회 + HR 쪽 Ingest)은 이번 세션 범위 밖 — HR 담당(영주님) 협의 필요.
#------------------------------------------------------------------------------
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=


#------------------------------------------------------------------------------
# 4. Database  [NOW/SPEC]
#
# Supabase(운영 DB) Migration : supabase/migrations/   -> supabase db reset
# TimescaleDB(시장 시계열)     : timescaledb/migrations/
#   psql "$TIMESCALE_DATABASE_URL" -f timescaledb/migrations/001_initial_market_data.sql
#   (docs/database/README.md 7절 — 변수명을 이 이름 그대로 유지한다)
#
# 루트 db/001_execution.sql ~ 004_seed.sql 은 D0-D2 Prototype 전용이며
# supabase/migrations/ 와 같은 Database에 함께 적용하지 않는다.
#
# TimescaleDB 직접 Credential은 리서치·퀀트에만 부여한다. 트레이딩·리스크·
# 회계·QA·CEO·인사팀은 이 값 없이 market-api 의 Snapshot·Bar·Feature
# Endpoint를 쓴다.
#
# 로컬 개발은 docker-compose.yml 이 띄우는 컨테이너를 쓴다 (compose 프로젝트
# hedgefund, 호스트 포트 5434, DB: market). 아래처럼 채운다.
#   TIMESCALE_DATABASE_URL=postgresql://postgres:<pw>@localhost:5434/market
# 비밀번호는 URI percent-encoding 문제를 피하려고 영숫자만 쓰는 것을 권한다.
#------------------------------------------------------------------------------
TIMESCALE_DATABASE_URL=
HEDGEFUND_TSDB_PASSWORD=

# Supabase. ANON_KEY와 SERVICE_ROLE_KEY를 반드시 구분한다.
# SERVICE_ROLE_KEY / DATABASE_URL 은 Backend 전용 — Browser, Agent Prompt,
# Log, Dataset에 넣지 않는다. RLS는 활성 상태를 유지하고 Frontend에는
# api Schema만 노출한다.
#
# Supabase Project 자체는 GitHub-Supabase 연동으로 관리한다. 아래 값은
# 로컬 검증용으로만 채운다.
#
# 비밀번호에 @ : / ? # [ ] 같은 문자가 있으면 URI에서 percent-encoding 한다
# (@ -> %40). 인코딩하지 않으면 Driver에 따라 Host 파싱이 틀어진다.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# DB 비밀번호를 URL과 별개로 쓰는 도구(psql, Supabase CLI)용. DATABASE_URL과
# 값이 갈리지 않게 한 곳을 고치면 다른 곳도 함께 고친다.
SUPABASE_PASSWORD=


#------------------------------------------------------------------------------
# 5. Redis  [SPEC] — Hot Cache, Event Priority Queue, Dedup/Cooldown, Job Lease
#
# 영구 Source of Truth가 아니다. 유실 후 PostgreSQL/Parquet에서 재구성 가능해야
# 한다. 초기에는 Docker Redis를 쓴다.
#------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0


#------------------------------------------------------------------------------
# 6. LS증권 Open API  [SPEC] — 가격·체결·호가의 확정 Source
#
# docs/03-data/RESEARCH_DATA_SOURCES_AND_LIBRARIES.md 5.1
# docs/06-integrations/ls-openapi/  (8개 대분류, 42 API, 365 TR 전체 참조)
#
# /oauth2/token 요청 바디가 appkey / appsecretkey 를 받는다(각 36자).
# 응답 access_token 을 이후 모든 TR의 authorization 헤더에 넣는다.
#
# ▶ 변수 이름 규칙 — 모의투자는 `_PAPER` 접미사다. `LS_MOCK_*` 을 쓰지 않는다.
#   저장소 문서가 거래 환경을 Paper(286건)/Live(65건)로 부르고, "Mock"은
#   Mock Contract·Mock Tool 처럼 테스트 더블을 가리키는 별개 용어로만 쓴다
#   (docs 전체에서 4건, 모두 테스트 더블). 두 개념을 같은 접두어로 섞지 않는다.
#------------------------------------------------------------------------------

# 실행 환경 스위치 — PAPER | LIVE.
# LIVE 전환은 Production Launch Gate 통과 후에만 한다. 기본값은 PAPER다.
LS_ENV=PAPER

# --- 실전투자(Live) ---
LS_APP_KEY=
LS_APP_SECRET_KEY=
LS_REST_BASE_URL=https://openapi.ls-sec.co.kr:8080
LS_WS_BASE_URL=wss://openapi.ls-sec.co.kr:9443

# --- 모의투자(Paper) ---
#
# 실전과 별개로 발급받은 App의 Key를 넣는다. 위 규칙("환경별 local/paper/live
# 계정·Network·Secret·Broker Credential을 완전히 분리한다")에 따라 실전 Key와
# 절대 섞지 않는다. 한쪽 값을 다른 쪽에 복사하지 않는다.
#
# 수집 문서(docs/06-integrations/ls-openapi/) 기준 모의투자 Domain은 OAuth와
# 주문·계좌를 포함한 REST 전부 `-`(미제공)이고, WebSocket 실시간 시세만 :29443
# 이 있다. 그래서 LS_REST_BASE_URL_PAPER 변수를 만들지 않는다 — REST 모의주문
# 가능 여부와 모의투자 토큰 발급 Domain은 미확인이며, 실제 호출로 확인한 뒤
# 이 주석을 갱신할 것.
LS_APP_KEY_PAPER=
LS_APP_SECRET_KEY_PAPER=
LS_WS_BASE_URL_PAPER=wss://openapi.ls-sec.co.kr:29443

# --- 계좌 Credential ---
#
# 주문·계좌 API Credential은 Market Data Credential과 분리한다.
# 계좌번호는 보통 11자리이고, 주문 TR(CSPAT00601)이 AcntNo(계좌번호)와
# InptPwd(입력비밀번호 8자)를 요청 필드로 요구한다.
# Paper/Live Broker가 미확정이라 Live 쪽은 주석 상태로 둔다.
LS_ACCOUNT_NO_PAPER=
LS_ACCOUNT_PWD_PAPER=
# LS_ACCOUNT_NO=
# LS_ACCOUNT_PWD=


#------------------------------------------------------------------------------
# 7. 리서치 외부 데이터 Source  [SPEC]
#
# docs/03-data/RESEARCH_DATA_SOURCES_AND_LIBRARIES.md 5.2 ~ 5.5
# 아래는 우리 쪽 변수명이다. 각 Vendor의 실제 요청 파라미터명과 호출 한도는
# 해당 Vendor 가이드에서 확인하고 Source Registry Config로 관리한다
# (한도를 코드에 하드코딩하지 않는다).
#------------------------------------------------------------------------------

# Open DART — 공시·기업개황·재무제표 P0 Source. 요청 파라미터명은 crtfc_key.
OPEN_DART_API_KEY=

# KRX Data Marketplace Open API — 거래소 Reference·일별 통계 보완 Source
KRX_API_KEY=

# BIGKinds — 국내 뉴스. 저작권상 본문이 첫 200자로 제한될 수 있다.
# 검색 / Snippet 저장 / 전문 저장 / Embedding·LLM 사용 / 장기 Archive /
# 외부 재배포 권한을 각각 구분해서 확인할 것.
BIGKINDS_API_KEY=

# NAVER API HUB — Search API가 개발자센터에서 이관 중(2026-07 기준).
# 과거 Endpoint에 결합하지 말고 NewsSearchProvider Adapter로 분리한다.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Macro — 국내는 ECOS/KOSIS, 국제는 FRED/ALFRED부터 시작
ECOS_API_KEY=
KOSIS_API_KEY=
FRED_API_KEY=


#------------------------------------------------------------------------------
# 8. Model Gateway  [SPEC] — Bedrock Claude + Ollama
#
# docs/02-engineering/TECH_STACK_DECISIONS.md 3절
# AWS Credential은 환경 변수 Access Key보다 Local Profile / Workload Identity를
# 우선한다. 그래서 AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY를 여기 두지 않는다.
#
# Ollama Embedding과 Bedrock Embedding은 Vector Space가 다르다. 하나의 Index에
# 섞지 않고, Model을 바꾸면 새 Index를 만들어 재색인한다.
#------------------------------------------------------------------------------
AWS_REGION=
AWS_PROFILE=
BEDROCK_MODEL_ID=
BEDROCK_EMBEDDING_MODEL_ID=

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=
OLLAMA_EMBEDDING_MODEL=


#------------------------------------------------------------------------------
# 9. Observability와 환경 구분  [SPEC]
#
# P0는 structlog. OpenTelemetry와 Prometheus는 P1.
# LangSmith는 금융 데이터 외부 전송 정책·비용 검토 전까지 필수 도구가 아니다.
#------------------------------------------------------------------------------
APP_ENV=local
OTEL_SERVICE_NAME=personal-hedge-fund-agent
OTEL_EXPORTER_OTLP_ENDPOINT=
