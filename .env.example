# HgFinance root environment template
#
# Usage:
#   cp .env.example .env
#   $EDITOR .env
#   docker compose config --quiet
#
# This file contains variable names and safe placeholders only. Never copy
# credentials from a live .env into this file. Replace every CHANGE_ME value
# before starting a service that needs it. The root .env is read by Compose;
# Hermes profile credentials are intentionally kept in profile-local runtime
# directories (see the Hermes section below).

# ============================================================================
# 1. Compose-required database and internal pipeline settings
# ============================================================================
# Required by the default Compose stack. Use the DSN for the PostgreSQL
# database that the API services are allowed to access (Supabase in AWS, or a
# local/test PostgreSQL instance).
DATABASE_URL=postgresql://DB_USER:CHANGE_ME_DB_PASSWORD@DB_HOST:5432/DB_NAME

# Required by the local TimescaleDB container. Compose uses this value to set
# the market database password and builds the in-network DSN automatically.
HEDGEFUND_TSDB_PASSWORD=CHANGE_ME_TSDB_PASSWORD

# Required by news-watcher and batch-collectors in the default stack.
NAVER_CLIENT_ID=CHANGE_ME_NAVER_CLIENT_ID
NAVER_CLIENT_SECRET=CHANGE_ME_NAVER_CLIENT_SECRET

# Required by batch-collectors for document/archive storage.
SUPABASE_URL=https://CHANGE_ME_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=CHANGE_ME_SUPABASE_SERVICE_ROLE_KEY

# Optional read-only/client-side Supabase values. Do not use the anon key or
# service-role key as a substitute for DATABASE_URL in durable services.
SUPABASE_ANON_KEY=
SUPABASE_DATABASE_URL=
SUPABASE_PASSWORD=

# ============================================================================
# 2. CEO closed-loop entrypoint
# ============================================================================
# Shared secret for portfolio-bff -> ceo-hermes:8642. Use a generated secret
# of at least 16 characters in real environments. Compose passes this value to
# both services; the API is not published on a host port.
CEO_HERMES_API_KEY=CHANGE_ME_CEO_HERMES_KEY_32_CHARS

# These are intentionally fixed in docker-compose.yml, not user-overridable
# root variables:
#   ENABLE_AGENT_ASK=true
#   ENABLE_KANBAN_TASK_TRACKING=1
#   HERMES_BIN=/usr/local/bin/hermes
#   HERMES_HOME=/opt/hermes-cli       (portfolio-bff CLI-only runtime)
#   HERMES_KANBAN_HOME=/opt/kanban
#   HERMES_CEO_API_URL=http://ceo-hermes:8642/v1
# BFF does not mount the CEO profile or start a Hermes gateway.

PORTFOLIO_BFF_PORT=8001
PORTFOLIO_GOVERNANCE_BINDING_ENABLED=false
GOVERNANCE_API_URL=
GOVERNANCE_API_AUTH_TOKEN=
GOVERNANCE_WORKFORCE_DATABASE_URL=
GOVERNANCE_EVENT_POLL_INTERVAL_SECONDS=1

# The portfolio worker is a separate service. Keep the embedded worker off.
PORTFOLIO_WORKER_POLL_SECONDS=0.5
PORTFOLIO_WORKER_LEASE_SECONDS=60
PORTFOLIO_RUNTIME_STORE_PATH=/var/lib/portfolio/runtime.sqlite3
PORTFOLIO_RUNTIME_EMBEDDED_WORKER=false

# ============================================================================
# 3. Redis and service polling
# ============================================================================
# Use the Compose service name here. redis://localhost is wrong inside the
# notification, workforce, and worker containers.
REDIS_URL=redis://redis:6379/0
RISK_QA_EVENT_REDIS_URL=redis://redis:6379/0

QA_EVENT_POLL_INTERVAL_SECONDS=1
WORKFORCE_EVENT_POLL_INTERVAL_SECONDS=1
RELAY_POLL_SECONDS=1.0
RELAY_MAX_ATTEMPTS=12
LEDGER_CONSUMER_POLL_SECONDS=1.0
ACCOUNTING_MARK_INTERVAL=

# Internal Compose service URL used by accounting consumers/schedulers.
MARKET_API_URL=http://market-api:8036
RESEARCH_API_URL=http://research-api:8035

# ============================================================================
# 4. Research collectors and source credentials
# ============================================================================
# Optional source credentials may be left empty. A collector must fail closed
# when its source is not configured; do not replace these with fake keys.
TAVILY_API_KEY=
OPEN_DART_API_KEY=
KRX_API_KEY=
BIGKINDS_API_KEY=
ECOS_API_KEY=
KOSIS_API_KEY=
FRED_API_KEY=
UNPAYWALL_EMAIL=

# Collector selection/timing. The watchlist files are mounted by Compose.
NEWS_WATCH_SYMBOLS=
NEWS_POLL_INTERVAL_SECONDS=1800
NEWS_WATCH_TOP=20
NEWS_WATCH_DISPLAY=20
NEWS_SINK_MAX_BATCH=20
NEWS_SINK_MAX_DELAY_SECONDS=5.0

# Research MCP authentication. Keep empty only if the local MCP contract is
# intentionally unauthenticated; use a real secret in shared environments.
MCP_RESEARCH_API_KEY=CHANGE_ME_MCP_RESEARCH_API_KEY
TOOL_GATEWAY_ENFORCE=false
TOOL_GATEWAY_ENFORCE_MARKET=false

# Optional external research/news adapters, not required by the core Compose
# graph. Configure only the adapter that is explicitly enabled.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_DATA_BASE_URL=
ALPACA_NEWS_WS_URL=
FOREIGN_NEWS_API_KEY=
SERPAPI_KEY=

# ============================================================================
# 5. LS Securities API (paper-safe defaults)
# ============================================================================
LS_ENV=PAPER
LS_APP_KEY=
LS_APP_SECRET_KEY=
LS_APP_KEY_PAPER=
LS_APP_SECRET_KEY_PAPER=
LS_REST_BASE_URL=https://openapi.ls-sec.co.kr:8080
LS_REST_BASE_URL_PAPER=https://openapi.ls-sec.co.kr:8080
LS_WS_BASE_URL=wss://openapi.ls-sec.co.kr:9443
LS_WS_BASE_URL_PAPER=wss://openapi.ls-sec.co.kr:29443
LS_ACCOUNT_NO_PAPER=
LS_ACCOUNT_PWD_PAPER=
LS_ACCOUNT_NO=
LS_MAC_ADDRESS=
LS_OAUTH_SCOPE=oob

# ============================================================================
# 6. Worker and local-model runtime
# ============================================================================
# Host processes use OLLAMA_BASE_URL. Compose services use the Docker-specific
# value through OLLAMA_DOCKER_BASE_URL.
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_DOCKER_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_CHAT_MODEL=qwen3:1.7b
OLLAMA_EMBEDDING_MODEL=
OLLAMA_TIMEOUT_SECONDS=8
OLLAMA_API_KEY=ollama
PORTFOLIO_WORKER_RUNTIME=ollama

# Optional API-provider values used by Risk/QA or direct local execution.
# Hermes Head provider credentials do not belong here; see section 8.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# ============================================================================
# 7. Risk, QA, accounting, and policy integrations
# ============================================================================
# Safe local/paper defaults. Production enablement requires the corresponding
# approved policy corpus, database, credentials, and readiness checks.
RISK_QA_RUNTIME=test
RISK_DATA_MODE=test
RISK_REQUIRE_P1_ANALYTICS=false
RISK_QA_PRODUCTION_ENABLED=false
RISK_CONTEXT_SOURCE=request
RISK_BROKER_ADAPTER=
RISK_EXTERNAL_API_TIMEOUT_SECONDS=5
RISK_QA_DATABASE_URL=

RISK_SERVICE_AUTH_SECRET=CHANGE_ME_RISK_SERVICE_SECRET
RISK_SERVICE_AUTH_ISSUER=hgfinance-risk
RISK_SERVICE_AUTH_AUDIENCE=hgfinance-internal
QA_SERVICE_AUTH_SECRET=CHANGE_ME_QA_SERVICE_SECRET
QA_SERVICE_AUTH_ISSUER=hgfinance-qa
QA_SERVICE_AUTH_AUDIENCE=hgfinance-internal

QA_INGEST_MODE=production
QA_POLICY_SOURCE_ID=
QA_CHECK_CONTRACT_APPROVED=false
QA_POLICY_CORPUS_DIR=
QA_EVIDENCE_CORPUS_DIR=
QA_TRACE_PERSIST=false

ACCOUNTING_MODE=PAPER_DB
PAPER_DB=true
DISCORD_WEBHOOK_URL=
ACCOUNTING_DEFAULT_BOOK_ID=

RISK_API_URL=http://127.0.0.1:8041
RISK_API_AUTH_TOKEN=
RISK_API_TIMEOUT_SECONDS=8
QA_API_URL=http://127.0.0.1:8042
QA_API_AUTH_TOKEN=
QA_API_TIMEOUT_SECONDS=8

# Optional legal/policy source.
LAW_API_ENABLED=false
LAW_API_BASE_URL=https://www.law.go.kr
LAW_API_OC=
LAW_API_TIMEOUT_SECONDS=10

# Optional vector/RAG integrations. The deterministic validation path remains
# fail-closed when these are absent.
PINECONE_API_KEY=
PINECONE_INDEX_HOST=
PINECONE_NAMESPACE=
PINECONE_TIMEOUT_SECONDS=8

AGENTIC_RAG_CHAT_MODEL=gpt-4o-mini
AGENTIC_RAG_EMBEDDING_MODEL=text-embedding-3-small
AGENTIC_RAG_EMBEDDING_DIMENSIONS=1024
AGENTIC_RAG_MAX_CONTEXT_CHARS=6000
AGENTIC_RAG_LLM_FAILURE_THRESHOLD=3
AGENTIC_RAG_LLM_RECOVERY_SECONDS=30
AGENTIC_RAG_PROMPT_CACHE_TTL_SECONDS=604800
AGENTIC_RAG_EMBED_FAILURE_THRESHOLD=3
AGENTIC_RAG_EMBED_RECOVERY_SECONDS=30
AGENTIC_RAG_EMBED_CACHE_TTL_SECONDS=604800
AGENTIC_RAG_RETRIEVAL_MODE=vector

# ============================================================================
# 8. Hermes profile-local runtime boundary
# ============================================================================
# Do NOT put provider credentials or auth.json contents in the root .env.
# The eight gateway profiles are mounted from:
#   ~/.hermes/profiles/<profile>/
# and are synchronized from departments/*/hermes with:
#   ./scripts/sync_hermes_profiles.sh push
#
# Current canonical profiles:
#   ceo-agent
#   hr-department
#   research-department
#   quant-backtest-department
#   trading-department
#   accounting-portfolio-department
#   risk-management
#   qa-department
#
# Each profile owns its provider environment/auth independently. Depending on
# the profile config, provider values such as ANTHROPIC_API_KEY or
# OPENAI_API_KEY belong in that profile's runtime .env, not in this root
# template. The standalone kanban-dispatcher alone sees the full Hermes home;
# it does not start profile gateways.

# ============================================================================
# 9. Observability (optional, non-blocking by default)
# ============================================================================
APP_ENV=local
OTEL_SERVICE_NAME=hgfinance
OTEL_EXPORTER_OTLP_ENDPOINT=
RISK_QA_OTEL_ENABLED=0

LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=

LANGFUSE_TRACING=false
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ============================================================================
# 10. Host-only/spec settings
# ============================================================================
# These are useful for direct local scripts or future integrations, but are
# not injected into every container by docker-compose.yml.
AWS_REGION=ap-northeast-2
AWS_PROFILE=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_MODEL_ID=
BEDROCK_EMBEDDING_MODEL_ID=

# Used by host-side psql/research/quant scripts. Compose builds its internal
# Timescale DSN from HEDGEFUND_TSDB_PASSWORD instead.
TIMESCALE_DATABASE_URL=postgresql://postgres:CHANGE_ME_TSDB_PASSWORD@127.0.0.1:5434/market

# Direct-run application defaults; Compose service entries set their own
# in-network URLs where required.
GOVERNANCE_API_TIMEOUT_SECONDS=8
PORTFOLIO_RUNTIME_STORE_DIR=/tmp
PORTFOLIO_GOVERNANCE_BINDING_PATH=/governance/v1/mandates/current
PORTFOLIO_AUTH_REQUIRED=false
PORTFOLIO_REQUIRE_MANDATE_BINDING=false
UI_SNAPSHOT_CACHE_SECONDS=2

