# 카드를 실제로 도는 에이전트가 뜨는 곳 - `kanban-dispatcher` 의 이미지.
#
# ▶ 왜 부서 컨테이너가 아닌가 (2026-08-11 실측, 2026-08-12 재확인)
#   dispatcher 는 카드를 부서 컨테이너로 넘기지 않는다. 자기 안에서
#   `hermes -p <부서> ... chat -q work kanban task <id>` 를 직접 띄운다
#   (프로필 8개를 전부 마운트하는 이유가 이것이다). 부서 컨테이너는
#   `gateway run` - 메시징·크론만 돈다.
#
#   그래서 **작업면은 여기 있어야 한다.** 부서 컨테이너에 파이썬을 넣어도
#   에이전트는 그것을 보지 못한다(2026-08-12 에 그렇게 만들었다가 되돌렸다).
#
# ▶ 퀀트만 작업면을 쓴다 - 나머지 부서는 왜 안 쓰나
#   다른 본부는 서술하는 조직이라 "사실은 결정론이 모으고 에이전트는 판단·
#   서술만 한다"가 맞고, 브리핑을 호스트가 만들어 카드 본문으로 건넨다.
#   퀀트는 **공학 부서**다 - 데이터셋을 만들고 전략을 돌리는 것이 본업인데,
#   그걸 카드 본문으로 서술하게 만든 결과가 `done 6장 / 결과 0자` 였다.
#
#   이미지는 하나지만 **자격은 프로필별로 갈린다.** DB DSN 은 퀀트 프로필의
#   `env:` 에만 있으므로, 같은 컨테이너에서 떠도 다른 본부 에이전트는
#   원장에 닿지 못한다. 저장소는 읽을 수 있다 - 코드는 비밀이 아니다.
#
# ▶ 그래도 지키는 불변식
#   불변식은 "에이전트가 데이터에 못 닿는다"가 아니라 **"감사되지 않은 사실이
#   원장에 들어가지 않는다"** 이다. 에이전트는 결정론 진입점(pit_dataset.py
#   --build, backtest_runner.py --run, experiment_orchestrator.py --run)을
#   실행한다 - 사전등록 지문·content_hash·매니페스트가 거기서 박힌다.
#   그 코드를 고칠 수는 있고(공학 부서니까), 고친 코드는 QA·감사 대상이다.
FROM nousresearch/hermes-agent:latest

# 시스템 파이썬은 Hermes 런타임 자신이 쓴다 - 건드리지 않는다. 작업용 의존성은
# 별도 venv 에 격리한다(베이스 이미지에 pip 이 없고 uv 는 이미 들어 있다).
# 버전은 Dockerfile.factory 와 맞춘다 - 같은 파이프라인을 호스트/공장/여기서
# 돌리는데 버전이 갈리면 content_hash 가 갈릴 수 있다.
RUN uv venv /opt/quant-venv --python python3 \
 && uv pip install --python /opt/quant-venv/bin/python --no-cache \
      psycopg2-binary==2.9.10 pydantic==2.11.7 python-dotenv==1.1.1 \
      numpy==2.3.2 pandas==2.3.1 pyarrow==25.0.0 \
 && chmod -R a+rX /opt/quant-venv

# 에이전트가 경로를 외우지 않게 이름을 준다. 프로필 페르소나에서 `quant-py` 로 안내한다.
RUN printf '#!/bin/sh\nexec /opt/quant-venv/bin/python "$@"\n' > /usr/local/bin/quant-py \
 && chmod +x /usr/local/bin/quant-py

# ── Agent-Reach - 리서치 스카우트의 웹 접근면 ────────────────────────────────
#
# ▶ 왜 (2026-08-12, 재일 지시)
#   리서치 프로필에 스카우트 렌즈가 4개 정의돼 있는데 실제 수집은
#   ACADEMIC 11건 / PRACTITIONER 1건 / **COMMUNITY 0건 / CROSSDOMAIN 0건** 이다.
#   뒤 둘이 노리는 것이 포럼·영상인데 닿을 도구가 없었다. 그래서 리드가 전부
#   학술 논문이고, 같은 우물만 파다 어제 배치가 통째로 `VAGUE` 로 떨어졌다.
#
# ▶ 무인증 채널만 켠다 - X·LinkedIn·Reddit 은 제외한다(재일 지시)
#   그 셋은 쿠키가 필요한데, 에이전트는 8개 본부가 **이 컨테이너 하나**에서
#   뜨므로 쿠키를 여기 두면 전 부서가 공유하게 된다. 무인증 채널
#   (web/Jina · YouTube/yt-dlp · GitHub/gh · RSS · Exa · Bilibili)만 쓰면
#   그 문제가 아예 생기지 않는다. 인증 채널이 필요해지면 자격은 compose 가
#   아니라 **리서치 프로필의 `env:`** 로 넣는다(DB DSN 을 퀀트 프로필에만
#   넣은 것과 같은 방식).
#
# ▶ 깔아만 두면 안 쓴다
#   오늘 `quant-py` 로 배웠다 - 도구를 넣고 페르소나에 한 줄 적었더니 4,400자
#   안에 묻혀 에이전트가 못 봤다. 스킬·카드 본문에 실제 명령을 박아야 한다.
RUN uv venv /opt/agent-reach-venv --python python3 \
 && uv pip install --python /opt/agent-reach-venv/bin/python --no-cache \
      "https://github.com/Panniantong/agent-reach/archive/main.zip" \
 && ln -sf /opt/agent-reach-venv/bin/agent-reach /usr/local/bin/agent-reach \
 # yt-dlp 는 위 설치에 이미 들어온다(2026.7.4). 그런데 venv/bin 이 PATH 에 없어
 # `agent-reach doctor` 가 "yt-dlp 未安装" 으로 잡았다 - **설치 문제가 아니라
 # PATH 문제였다.** 오늘 세 번째로 만난 "있는데 안 보이는" 유형이다.
 && ln -sf /opt/agent-reach-venv/bin/yt-dlp /usr/local/bin/yt-dlp \
 # feedparser 등 채널 의존성은 이 venv 에만 있다. 시스템 python3 로 부르면
 # `ModuleNotFoundError` 다 - 2026-08-12 실측에서 에이전트가 실제로 그걸 맞고
 # `uv run --with feedparser` 로 스스로 우회했다. 이름을 줘서 우회가 필요 없게
 # 한다(퀀트의 `quant-py` 와 같은 방식).
 && printf '#!/bin/sh\nexec /opt/agent-reach-venv/bin/python "$@"\n' > /usr/local/bin/reach-py \
 && chmod +x /usr/local/bin/reach-py \
 && chmod -R a+rX /opt/agent-reach-venv

# yt-dlp JS 런타임. doctor 가 "yt-dlp 已安装但未配置 JS runtime" 으로 잡는다.
# **시스템 전역 `/etc/yt-dlp.conf` 에 쓴다** - dispatcher 는 uid 1000 인데
# `HOME=/` 이라(실측) 홈 설정 파일을 못 쓴다. 홈에 쓰라는 doctor 안내를 그대로
# 따르면 root 로 돌 때만 먹고 실제 에이전트에는 안 먹는다.
RUN printf -- '--js-runtimes node\n' > /etc/yt-dlp.conf && chmod a+r /etc/yt-dlp.conf

# GitHub CLI - 저장소·코드 채널. Debian 기본 저장소에 없어 공식 apt 저장소를 쓴다.
# 실패해도 빌드를 죽이지 않되 **조용히 넘어가지 않는다** - 로그에 남겨서
# doctor 가 "없음" 이라고 할 때 왜인지 알 수 있게 한다.
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends curl ca-certificates gnupg; \
    (curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
       -o /usr/share/keyrings/githubcli.gpg \
     && echo "deb [signed-by=/usr/share/keyrings/githubcli.gpg] https://cli.github.com/packages stable main" \
       > /etc/apt/sources.list.d/github-cli.list \
     && apt-get update && apt-get install -y --no-install-recommends gh) \
    || echo "!! gh 설치 실패 - GitHub 채널은 doctor 에서 미설치로 뜬다"; \
    rm -rf /var/lib/apt/lists/*

# mcporter - Exa 전망 의미검색(무료 키 불필요)과 LinkedIn MCP 가 이걸 탄다.
# Node 는 베이스 이미지에 이미 있다(doctor 확인).
RUN npm install -g mcporter \
    || echo "!! mcporter 설치 실패 - Exa·LinkedIn 채널은 doctor 에서 미설치로 뜬다"

# 로그인이 필요한 채널의 클라이언트. **자격은 여기 안 굽는다** - 도구만 넣고
# 쿠키·토큰은 프로필 쪽에서 넣는다(아래 AGENT_REACH_HOME 참고).
RUN uv pip install --python /opt/agent-reach-venv/bin/python --no-cache \
      rdt-cli \
    || echo "!! rdt-cli 설치 실패 - Reddit 채널은 OpenCLI 경로만 남는다"

# 저장소는 COPY 하지 않고 마운트한다 - 에이전트가 고친 코드가 호스트에 남아야
# 리뷰·커밋 대상이 된다. 이미지에 굽으면 고친 것이 컨테이너와 함께 사라진다.
# ▶ AGENT_REACH_HOME 을 **리서치 프로필 안**에 둔다
#   `/opt/data` 는 dispatcher 공용이라 거기 쿠키를 두면 8개 본부 에이전트가
#   전부 읽는다. 리서치 프로필 디렉터리로 내리면 자격의 주인이 분명해진다
#   (오늘 DB DSN 을 퀀트 프로필 `env:` 에만 넣은 것과 같은 방식).
#
#   ⚠ 이것은 **관례이지 강제가 아니다.** 프로필 8개가 같은 컨테이너에 마운트돼
#   있으므로 다른 부서 에이전트가 경로를 알면 읽을 수 있다. 진짜 격리는
#   부서별 dispatcher 를 나누는 것이고, 그건 별도 작업이다.
# XDG_CONFIG_HOME - mcporter(Exa) 같은 도구가 설정을 쓸 자리. dispatcher 의
# HOME 은 `/` 이고 uid 1000 은 거기 못 쓴다. `/opt/data` 는 마운트된 볼륨이라
# 쓸 수 있고 컨테이너를 다시 만들어도 설정이 남는다.
# ▶ **QUANT_REPO 는 저장소 루트다 - `/app` 이 아니다** (2026-08-12 실측)
#   처음에 `/app` 으로 박아 뒀는데, 그 뒤 저장소 전체를 `/app/repo` 로 붙였다.
#   `/app/departments` 에는 퀀트 하나만 있으므로 에이전트가 저장소 루트라고
#   믿고 다른 부서를 찾다 못 찾았고, **"source_registry.py: ABSENT / File search
#   under /app: 0 results"** 로 `BLOCKED` 판정을 냈다. 파일은 멀쩡히 있었다
#   (`/app/repo/departments/01-research/collectors/source_registry.py`, 54,905B).
#   리스크 게이트가 그 판정을 받아 `NOT_RUNNABLE` 을 냈고, 에이전트는 155초를
#   쓴 뒤 "인프라 담당자가 저장소를 복원해야 한다" 는 조치까지 적었다.
#
#   두 경로의 역할이 다르다:
#     QUANT_WORKSPACE  쓰기. 퀀트가 고쳐도 되는 코드
#     QUANT_REPO       읽기 전용. 저장소 전체(진단·탐색용)
ENV QUANT_PYTHON=/opt/quant-venv/bin/python \
    QUANT_REPO=/app/repo \
    QUANT_WORKSPACE=/app/departments/04-quant-backtest \
    XDG_CONFIG_HOME=/opt/data/.config \
    AGENT_REACH_HOME=/opt/data/profiles/research-department/.agent-reach
