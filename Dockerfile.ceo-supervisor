# CEO Kanban supervisor용 Hermes 실행 이미지.
#
# supervisor는 순정 Hermes 이미지에서 직접 python3를 실행하므로,
# QA terminal projection이 사용하는 동기 PostgreSQL driver를 이미지 빌드
# 단계에 포함한다. 컨테이너 시작 시 pip install을 수행하지 않는다.
# Hermes의 기본 entrypoint, 명령, profile mount는 compose에서 그대로 유지한다.
FROM nousresearch/hermes-agent:latest

# The shared D5 SQLite ledger is created by the root BFF but written by this
# container after Hermes drops to uid 1000. Normalize that one state file at
# startup without running the supervisor itself as root.
COPY --chmod=0755 deploy/ceo-supervisor/entrypoint.sh /usr/local/bin/ceo-supervisor-entrypoint

# Supervisor가 직접 호출하는 Hermes native/CLI create 경계도
# ceo-hermes와 동일한 B7 validator를 사용한다. repository adapter preflight와
# 이미지 내부 durable-create guard가 서로 다른 role/key 해석을 갖지 않도록
# build-time에 같은 installer를 적용한다.
ENV PYTHONPATH="/opt/hgfinance"

COPY --chmod=0644 orchestration/__init__.py /opt/hgfinance/orchestration/__init__.py
COPY --chmod=0644 orchestration/primary_task_idempotency.py /opt/hgfinance/orchestration/primary_task_idempotency.py
COPY --chmod=0644 deploy/ceo-kanban/install_primary_idempotency.py /tmp/install_primary_idempotency.py
COPY --chmod=0644 deploy/ceo-kanban/install_result_contract.py /tmp/install_result_contract.py

RUN python3 /tmp/install_primary_idempotency.py \
    && python3 /tmp/install_result_contract.py \
    && rm -f /tmp/install_primary_idempotency.py /tmp/install_result_contract.py

# langfuse: 이 컨테이너는 카드 종료를 관측해 부서장 1턴을 발행한다
# (orchestration/adapters/ceo_supervisor.py::_publish_head_card_activity).
# 없으면 publish 가 ModuleNotFoundError 를 삼키고 **조용히 False** 를 돌려줘,
# 코드·자격증명·프로필 해석이 전부 정상인데 이벤트만 0건인 상태가 된다
# (2026-08-23 실측). 루트 requirements.txt 가 확인한 버전과 같은 pin.
# Hermes CLI와 supervisor가 동일한 runtime interpreter를 사용하도록 기존
# Hermes venv를 명시한다. system Python은 PEP 668 externally-managed 상태다.
ENV PATH="/opt/hermes/.venv/bin:${PATH}"

# Keep the LangSmith SDK new enough to expose the SmithDB v2 client.  Pinning
# the old Hermes-index build here left runtime containers on legacy helpers.
# The application itself never calls list_runs/read_run compatibility methods.
RUN test -x /opt/hermes/.venv/bin/python3 \
    && uv pip install \
        --python /opt/hermes/.venv/bin/python3 \
        --no-cache \
        psycopg2-binary==2.9.12 \
        fastapi \
        pydantic \
        redis==7.0.1 \
        langfuse==4.14.3 \
        langsmith==0.11.0 \
    && /opt/hermes/.venv/bin/python3 -c "import fastapi, pydantic, psycopg2, redis, langfuse, langsmith"
