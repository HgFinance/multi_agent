FROM python:3.12-slim

RUN pip install --no-cache-dir \
    psycopg2-binary==2.9.10 \
    pydantic==2.11.7 \
    python-dotenv==1.1.1 \
    websockets==15.0.1 \
    fastapi==0.116.1 \
    "uvicorn[standard]==0.35.0" \
    pyarrow==25.0.0 \
    mcp==1.26.0

WORKDIR /app/departments/01-research

# MCP only needs environment/source contracts and the market symbol parser.
# It deliberately receives no collector entrypoint or retention executable.
COPY departments/01-research/collectors/source_registry.py \
     departments/01-research/collectors/symbol_universe.py \
     ./collectors/
COPY departments/01-research/repository ./repository
COPY departments/01-research/api ./api
COPY departments/01-research/evidence ./evidence

# 퇴역한 종목별 Packet 파이프라인(agents/, scripts.py)은 이미지에 넣지 않는다.
# 활성 직원 registry는 compose가 employee_workers.py를 명시적으로 read-only
# 마운트하며, liaison surface에는 실행 capability 자체가 없다.

# The MCP server has no strategy-generation write surface.  Strategy research
# runs in the autonomous lab and writes only its own file-backed artifacts.
COPY departments/04-quant-backtest/pipeline/stock_universe.py \
     /app/departments/04-quant-backtest/pipeline/stock_universe.py

# langfuse: 이 이미지의 Worker 실행기가 HR 관측 이벤트를 발행한다
# (orchestration/llm_observability.publish_worker_activity). 없으면 publish 가
# ModuleNotFoundError 를 삼키고 **조용히 False** 를 돌려줘, 자격증명이 멀쩡한데
# 이벤트만 0건인 상태가 된다(2026-08-23 실측: ceo-kanban-supervisor 에서 같은
# 결함을 추적하는 데 몇 시간이 걸렸다). 루트 requirements.txt 와 같은 pin.
RUN pip install --no-cache-dir langgraph==0.6.7 langfuse==4.14.3

ENV PYTHONUNBUFFERED=1

CMD ["python", "api/mcp_server.py", "--serve"]
