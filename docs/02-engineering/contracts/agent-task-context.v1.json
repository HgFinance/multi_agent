{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hgfinance.local/contracts/agent-task-context.v1.json",
  "title": "HgFinance Agent Task Context v1",
  "description": "CEO/Department Head/Kanban 경계에서 전달하는 실행 업무 Context. 금융 결정을 직접 바인딩하지 않는다.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "task_id",
    "department",
    "worker",
    "route",
    "input_refs",
    "trace_id",
    "status",
    "attempt",
    "idempotency_key",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": {"const": "agent-task-context.v1"},
    "case_id": {"$ref": "#/$defs/id"},
    "task_id": {"$ref": "#/$defs/id"},
    "parent_task_id": {"$ref": "#/$defs/id"},
    "department_handoff_id": {"$ref": "#/$defs/id"},
    "department": {"$ref": "#/$defs/department"},
    "worker": {"type": "string", "minLength": 1, "maxLength": 128},
    "route": {"type": "string", "minLength": 1, "maxLength": 64},
    "input_refs": {"$ref": "#/$defs/artifact_refs_non_empty"},
    "trace_id": {"$ref": "#/$defs/id"},
    "status": {
      "type": "string",
      "enum": ["CREATED", "QUEUED", "RUNNING", "COMPLETED", "DEGRADED", "HOLD", "ESCALATED", "REJECTED", "CANCELLED"]
    },
    "attempt": {"type": "integer", "minimum": 1, "maximum": 3},
    "priority": {"type": "integer", "minimum": 0, "maximum": 100},
    "idempotency_key": {"type": "string", "minLength": 1, "maxLength": 256},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "department": {
      "type": "string",
      "enum": [
        "ceo-agent",
        "research-department",
        "trading-department",
        "risk-management",
        "quant-backtest-department",
        "accounting-portfolio-department",
        "qa-department",
        "hr-department"
      ]
    },
    "artifact_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "content_hash"],
      "properties": {
        "type": {"type": "string", "minLength": 1, "maxLength": 64},
        "id": {"$ref": "#/$defs/id"},
        "content_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "as_of": {"type": "string", "format": "date-time"},
        "provenance_ref": {"$ref": "#/$defs/id"},
        "acl_scope": {
          "type": "array",
          "items": {"type": "string", "minLength": 1, "maxLength": 128},
          "uniqueItems": true
        }
      }
    },
    "artifact_refs_non_empty": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/artifact_ref"},
      "uniqueItems": true
    }
  }
}
