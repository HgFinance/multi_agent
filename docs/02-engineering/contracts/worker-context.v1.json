{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hgfinance.local/contracts/worker-context.v1.json",
  "title": "HgFinance Worker Context v1",
  "description": "Department Head와 독립 LangGraph Runner/Worker 사이에서 전달하는 비바인딩 실행 Context.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "context_id",
    "schema_version",
    "case_id",
    "task_id",
    "input_contract",
    "department",
    "trace_id",
    "producer_worker",
    "consumer_worker",
    "status",
    "advisory",
    "reason_codes",
    "input_refs",
    "output_refs",
    "profile_version",
    "model_version",
    "adapter_version",
    "input_hash",
    "attempt",
    "timeout_ms",
    "created_at"
  ],
  "properties": {
    "context_id": {"$ref": "#/$defs/id"},
    "schema_version": {
      "type": "string",
      "enum": [
        "worker-context.v1",
        "research.worker-context.v1",
        "quant.worker-context.v1",
        "trading.worker-context.v1",
        "risk.worker-context.v1",
        "qa.worker-context.v1",
        "governance.worker-context.v1",
        "workforce.worker-context.v1",
        "accounting.worker-context.v1"
      ]
    },
    "case_id": {"$ref": "#/$defs/id"},
    "task_id": {"$ref": "#/$defs/id"},
    "department_handoff_id": {"$ref": "#/$defs/id"},
    "input_contract": {"type": "string", "minLength": 1, "maxLength": 128},
    "department": {"$ref": "#/$defs/department"},
    "trace_id": {"$ref": "#/$defs/id"},
    "producer_worker": {"type": "string", "minLength": 1, "maxLength": 128},
    "consumer_worker": {"type": "string", "minLength": 1, "maxLength": 128},
    "status": {
      "type": "string",
      "enum": ["COMPLETED", "DEGRADED", "HOLD", "ESCALATED", "REJECTED", "NOT_EXECUTED"]
    },
    "advisory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary"],
      "properties": {
        "summary": {"type": "string", "minLength": 1, "maxLength": 4000},
        "suggested_verdict": {"type": "string", "minLength": 1, "maxLength": 64}
      }
    },
    "reason_codes": {
      "type": "array",
      "items": {"type": "string", "minLength": 1, "maxLength": 128},
      "uniqueItems": true
    },
    "input_refs": {"$ref": "#/$defs/artifact_refs_non_empty"},
    "output_refs": {"$ref": "#/$defs/artifact_refs"},
    "profile_version": {"type": "string", "minLength": 1, "maxLength": 128},
    "model_version": {"type": "string", "minLength": 1, "maxLength": 128},
    "adapter_version": {"type": "string", "minLength": 1, "maxLength": 128},
    "input_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "output_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "calculation_version": {"type": "string", "minLength": 1, "maxLength": 128},
    "attempt": {"type": "integer", "minimum": 1, "maximum": 3},
    "timeout_ms": {"type": "integer", "minimum": 1, "maximum": 120000},
    "replay_manifest_ref": {"$ref": "#/$defs/id"},
    "created_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "department": {
      "type": "string",
      "enum": [
        "ceo-agent",
        "research-department",
        "trading-department",
        "risk-management",
        "quant-backtest-department",
        "accounting-portfolio-department",
        "qa-department",
        "hr-department"
      ]
    },
    "artifact_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "content_hash"],
      "properties": {
        "type": {"type": "string", "minLength": 1, "maxLength": 64},
        "id": {"$ref": "#/$defs/id"},
        "content_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "as_of": {"type": "string", "format": "date-time"},
        "provenance_ref": {"$ref": "#/$defs/id"},
        "acl_scope": {
          "type": "array",
          "items": {"type": "string", "minLength": 1, "maxLength": 128},
          "uniqueItems": true
        }
      }
    },
    "artifact_refs": {
      "type": "array",
      "items": {"$ref": "#/$defs/artifact_ref"},
      "uniqueItems": true
    },
    "artifact_refs_non_empty": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/artifact_ref"},
      "uniqueItems": true
    }
  }
}
