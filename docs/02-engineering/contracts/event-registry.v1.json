{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hgfinance.local/contracts/event-registry.v1.json",
  "schema_version": "event-registry.v1",
  "envelope_schema": "event-envelope-v1",
  "description": "Canonical Event 이름, 실제 Producer와 Planned Event를 분리하는 Registry",
  "statuses": ["IMPLEMENTED", "IMPLEMENTED_INTERNAL", "PLANNED", "LEGACY_ALIAS"],
  "case_bindings": ["required", "optional", "none"],
  "ownership": {
    "registry": "platform-api-architecture",
    "payload_schema": "producer-domain",
    "decision_and_ledger_events": "owning-domain"
  },
  "events": [
    {
      "event_type": "risk.decision.v1",
      "status": "IMPLEMENTED_INTERNAL",
      "layer": "internal",
      "producer": "risk-management",
      "consumers": ["trading-department", "qa-department", "ceo-agent"],
      "source": "departments/03-risk/risk_events/redis_event_bus.py",
      "case_binding": "optional",
      "notes": "내부 Risk bus contract. 외부 canonical Case event로 승격하지 않는다."
    },
    {
      "event_type": "qa.decision.v1",
      "status": "IMPLEMENTED_INTERNAL",
      "layer": "internal",
      "producer": "qa-department",
