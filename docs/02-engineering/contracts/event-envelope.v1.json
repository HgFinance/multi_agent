{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hgfinance.local/contracts/event-envelope.v1.json",
  "title": "HgFinance Event Envelope v1",
  "description": "부서 간 Event의 공통 메타데이터. Payload 원문은 전달하지 않고 저장된 Artifact를 참조한다.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_type",
    "schema_version",
    "trace_id",
    "producer",
    "occurred_at",
    "idempotency_key"
  ],
  "properties": {
    "event_id": {"type": "string", "format": "uuid"},
    "event_type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+\\.v[0-9]+$"
    },
    "schema_version": {"const": "event-envelope-v1"},
    "case_id": {"type": ["string", "null"], "format": "uuid"},
    "trace_id": {"type": "string", "format": "uuid"},
    "producer": {"type": "string", "minLength": 1},
    "occurred_at": {"type": "string", "format": "date-time"},
    "idempotency_key": {"type": "string", "minLength": 1, "maxLength": 255},
    "payload_ref": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["artifact_type", "artifact_id", "artifact_schema", "content_hash"],
          "properties": {
            "artifact_type": {"type": "string", "minLength": 1},
            "artifact_id": {"type": "string", "format": "uuid"},
            "artifact_schema": {"type": "string", "minLength": 1},
            "content_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
          }
        }
      ]
    }
  }
}
